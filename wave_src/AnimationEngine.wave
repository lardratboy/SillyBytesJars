	public void RemoveCanvas( Canvas canvas ) {
	
		DBUG_DUMP_MEMORY( "Start of RemoveCanvas()" )
		
		// --------------------------------------------------------------------
		
#if defined(USE_NOKIA)

		bg_nokia_G = null;
		nokia_G = null;
		
#endif

		bg_lcdui_G = null; 
		bg_Surface = null;
		lcdui_G = null;
		offscreen_Surface = null;
		
		// --------------------------------------------------------------------
		
		packedVisualsImage = null;
		
		// --------------------------------------------------------------------
		
		System.gc();
		
		DBUG_DUMP_MEMORY( "End of RemoveCanvas()" )
		
	}

	//
	//	SetCanvas
	//
	
	public boolean SetCanvas( Canvas canvas ) {
	
		// --------------------------------------------------------------------
		
		try {
		
			DBUG_DUMP_MEMORY( "Before composite image load" )
			
			packedVisualsImage = Image.createImage( visualsImageURL );
			
			packedVisualsWidth = (short)packedVisualsImage.getWidth();
			
			packedVisualsHeight = (short)packedVisualsImage.getHeight();
			
			DBUG_DUMP_MEMORY( "After composite image load" )
		
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_SET_CANVAS );

			return false;
		
		}
		
		// --------------------------------------------------------------------
		
		canvasWidth = canvas.getWidth();
		canvasHeight = canvas.getHeight();

		// setup the background surface
		// --------------------------------------------------------------------
		
		DBUG_DUMP_MEMORY( "Before BG image creation" )
		
		bg_Surface = Image.createImage( gameWidth, gameHeight );
		
		bg_lcdui_G = bg_Surface.getGraphics();
		
#if defined(USE_NOKIA)
		bg_nokia_G = DirectUtils.getDirectGraphics( bg_lcdui_G );
#endif
		
		DBUG_DUMP_MEMORY( "After BG image creation" )
		
		// --------------------------------------------------------------------
		
		center_display_x_offset = (canvasWidth - gameWidth) >> 1;
		center_display_y_offset = (canvasHeight - gameHeight) >> 1;

		if ( !canvas.isDoubleBuffered() ) {
		
			// do the offscreen thing	
			// ----------------------------------------------------------------
			
			DBUG_DUMP_MEMORY( "Before offscreen image creation" )
		
			int osw = (canvasWidth > gameWidth) ? gameWidth : canvasWidth;
			int osh = (canvasHeight > gameHeight) ? gameHeight : canvasHeight;

			offscreen_Surface = Image.createImage( osw, osh );
			
			lcdui_G = offscreen_Surface.getGraphics();

			// ----------------------------------------------------------------
			
#if defined(USE_NOKIA)

			nokia_G = DirectUtils.getDirectGraphics( lcdui_G );
			
#endif
			
			DBUG_DUMP_MEMORY( "After offscreen image creation" )
			
		}
		
		return true;
	
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	ClearBackground()
	//
	
	public void ClearBackground() {
	
#if !defined(RENDER_NOTHING)
	
		bg_lcdui_G.setClip( 0, 0, gameWidth, gameHeight );
		bg_lcdui_G.setColor( bg_even_color_r, bg_even_color_g, bg_even_color_b );
		bg_lcdui_G.fillRect( 0, 0, gameWidth, gameHeight );
		bg_lcdui_G.setColor( 0, 0, 0 );
		
#endif // !defined(RENDER_NOTHING)

	}
	
	//
	//	RenderBackgroundChecker()
	//
	
	public void RenderBackgroundChecker(
		int x
		,int y
		,int w
		,int h
		,boolean bOdd
		,CLIP_RECTANGLE optionalClippingRect
	) {
	
#if !defined(RENDER_NOTHING)

		if ( null != optionalClippingRect ) {
		
			int right, bottom;
			
			if ( (right = (x + w)) > optionalClippingRect.right ) {
			
				if ( 0 >= (w -= (right - optionalClippingRect.right)) ) return;
			
			}
			
			if ( (bottom = (y + h)) > optionalClippingRect.bottom ) {
			
				if ( 0 >= (h -= (bottom - optionalClippingRect.top)) ) return;
			
			}
			
			if ( x < optionalClippingRect.left ) {
			
				if ( 0 >= (w -= (optionalClippingRect.left - x)) ) return;
			
				x = optionalClippingRect.left;
				
			}
			
			if ( y < optionalClippingRect.top ) {
			
				if ( 0 >= (h -= (optionalClippingRect.top - y)) ) return;
				
				y = optionalClippingRect.top;
				
			}
			
		}
		
		y += scoreboardDisplayOffset;
		
		bg_lcdui_G.setClip( x, y, w, h );
		
#if defined(ONLY_DRAW_RECTS)

		bg_lcdui_G.setColor( 0, 0, 0 );
		bg_lcdui_G.fillRect( x, y, w, h );
		bg_lcdui_G.setColor( 255, 0, 255 );
		bg_lcdui_G.fillRect( x + 1, y + 1, w - 2, h - 2 );

#else

		if ( bOdd ) {
		
			bg_lcdui_G.setColor( bg_odd_color_r, bg_odd_color_g, bg_odd_color_b );
			
		} else {
		
			bg_lcdui_G.setColor( bg_even_color_r, bg_even_color_g, bg_even_color_b );
			
		}
		
		bg_lcdui_G.fillRect( x, y, w, h );

#endif // defined(ONLY_DRAW_RECTS)
		
#endif // !defined(RENDER_NOTHING)

	}
	
	// ------------------------------------------------------------------------
	
	//
	//	BeginPaint()
	//

	public void BeginPaint(
		Graphics g
		,int focus_x
		,int focus_y
		,int percentageIndicator
	) {
	
		// determine our method
		// --------------------------------------------------------------------
		
		if ( null == offscreen_Surface ) {
		
			lcdui_G = g;

			// ----------------------------------------------------------------
			
#if defined(USE_NOKIA)

			nokia_G = DirectUtils.getDirectGraphics( lcdui_G );
			
#endif

			int x_translation;
			
			if ( canvasWidth < gameWidth ) {
			
				x_translation = (canvasWidth>>1) - focus_x;
				
				int x_min = canvasWidth - gameWidth;
				
				if ( x_min > x_translation ) x_translation = x_min;

				int x_max = 0; // gameWidth - canvasWidth;
				
				if ( x_max < x_translation ) x_translation = x_max;
			
			} else {
				
				x_translation = center_display_x_offset;
			
			}
			
			int y_translation;
			
			if ( canvasHeight < gameHeight ) {
			
				y_translation = (canvasHeight>>1) - focus_y;
			
				int y_min = canvasHeight - gameHeight;
				
				if ( y_min > y_translation ) y_translation = y_min;

				int y_max = 0; //gameHeight - canvasHeight;
				
				if ( y_max < y_translation ) y_translation = y_max;
				
			} else {
			
				y_translation = center_display_y_offset;
			
			}

			lcdui_G.translate( x_translation, y_translation );
				
		} else {
		
			lcdui_G.setClip( 0, 0, gameWidth, gameHeight );
			
		}
	
		// erase everything?
		// --------------------------------------------------------------------
		
#if defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW) && (!defined(DRAW_EXTERNAL_RECTS_AFTER_EVERYTHING_ELSE))

		RenderExternalClipRects( g );

#endif // defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW) && (!defined(DRAW_EXTERNAL_RECTS_AFTER_EVERYTHING_ELSE))

		// start our rendering by drawing the background layer
		// --------------------------------------------------------------------
		
#if !defined(RENDER_NOTHING)	
		lcdui_G.drawImage(
			bg_Surface
			,0
			,0
			,Graphics.TOP | Graphics.LEFT
		);
#endif // !defined(RENDER_NOTHING)
		
		// check to see if we are counting down something
		// --------------------------------------------------------------------
		
		if ( (0 != percentageIndicator) && (2 < scoreboardDisplayOffset) ) {
		
			int w = (gameWidth * percentageIndicator) >> 8;
			
			if ( 0 != w ) {
			
				int h = (scoreboardDisplayOffset - 2);

				g.setClip( 0, 1, w, h );
				
				lcdui_G.setColor( 0, 0, 0 );
				
				lcdui_G.fillRect( 0, 1, w, h );
				
				if ( 0 < (w - 2) ) {
				
					lcdui_G.setColor(
						127 + (percentageIndicator >> 1)
						,0
						,0
					);

					lcdui_G.fillRect( 1, 2, w - 2, h - 2 );
					
				}
				
			}
		
		}
		
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	RenderExternalClipRects()
	//
	
#if defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW)

	private void RenderExternalClipRects( Graphics g ) {
	
		int xTranslation = g.getTranslateX();
		
		int yTranslation = g.getTranslateY();
	
		g.translate( -xTranslation, -yTranslation );
		
		g.setClip( 0, 0, canvasWidth, canvasHeight );
		
		{
			int x = center_display_x_offset;
			int y = center_display_y_offset;
		
			g.setColor( bg_even_color_r, bg_even_color_g, bg_even_color_b );

			// ----------------------------------------------------------------
			
			if ( 0 < y ) {

#if defined(J2ME_BASIC_BUILD)
			
				g.fillRect( 0, 0, canvasWidth, y + 1 );
				
#else

				g.fillRect( 0, 0, canvasWidth, y );
				
#endif
				
			}
			
			// ----------------------------------------------------------------
			
			if ( 0 < x ) {
			
				g.fillRect( 0, y, x, gameHeight );
				
			}
			
			x += gameWidth;

			if ( canvasWidth > x ) {
			
				g.fillRect( x, y, canvasWidth - x, gameHeight );
				
			}
	
			// ----------------------------------------------------------------
			
			y += gameHeight;
			
			if ( 0 < y ) {
			
				g.fillRect( 0, y, canvasWidth, canvasHeight - y );
				
			}
			
		}
		
		g.translate( xTranslation, yTranslation );
		
	}
	
#endif // defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW)
	
	// ------------------------------------------------------------------------
	
	//
	//	EndPaint()
	//
	
	public void EndPaint(
		Graphics g
#if defined(BPT_USE_SIMPLE_PROFILER)
		,SimpleProfiler profiler
#endif
	) {
	
		// --------------------------------------------------------------------
		
		if ( null == offscreen_Surface ) {
		
#if defined(USE_NOKIA)
			nokia_G = null;
#endif
			
			lcdui_G = null;
			
		} else {
		
#if !defined(RENDER_NOTHING)

			g.drawImage(
				offscreen_Surface
				,center_display_x_offset
				,center_display_y_offset
				,Graphics.TOP | Graphics.LEFT
			);
			
#endif // !defined(RENDER_NOTHING)
			
		}
		
		// --------------------------------------------------------------------
		
#if defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW) && defined(DRAW_EXTERNAL_RECTS_AFTER_EVERYTHING_ELSE)

		RenderExternalClipRects( g );

#endif // defined(DRAW_EXTERNAL_RECTS_TO_HIDE_OVERDRAW) && defined(DRAW_EXTERNAL_RECTS_AFTER_EVERYTHING_ELSE)

		// reverse any translation
		// --------------------------------------------------------------------
		
		g.translate( -g.getTranslateX(), -g.getTranslateY() );
		
		// --------------------------------------------------------------------

#if defined(REPORT_INTERNAL_FRAME_COUNTER)

		g.setClip( 0, 0, canvasWidth, canvasHeight );
		g.setColor( 255, 255, 255 );
		g.fillRect( 0, 0, canvasWidth, 16 );
		g.setColor( 0, 0, 0 );
		
		g.drawString(
			":" + dbug_FrameCounter
			,0
			,0
			,Graphics.TOP | Graphics.LEFT
		);
		
		++dbug_FrameCounter;
		
#endif
	
#if defined(REPORT_FRAME_TIME)

		g.setClip( 0, 0, canvasWidth, canvasHeight );
//		g.setColor( 255, 255, 255 );
//		g.fillRect( 0, 0, 48, canvasHeight );
		g.setColor( 0, 0, 0 );
		
		g.drawString(
			"(" + Runtime.getRuntime().freeMemory() + "/" + Runtime.getRuntime().totalMemory() + ")"
			,0
			,0
			,Graphics.TOP | Graphics.LEFT
		);
		
#if defined(BPT_USE_SIMPLE_PROFILER)
		if ( null != profiler ) {
		
			int yPos = 12;
		
			for ( int i = 0; i < profiler.m_ActiveEntries; i++ ) {
			
				g.drawString(
					profiler.m_Names[ i ] + ":" + profiler.m_Times[ i ]
					,0
					,yPos
					,Graphics.TOP | Graphics.LEFT
				);
				
				yPos += 12;
				
			}
		
		}
#endif // defined(BPT_USE_SIMPLE_PROFILER)
		
#endif
		
	}
	
}
