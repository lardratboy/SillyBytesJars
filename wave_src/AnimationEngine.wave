	static private class LAYERS_DATABASE {
	
		short visualIndex[];
		byte flags_8[];
		byte dx[];
		byte dy[];
		
		// Need to make the layers database have start indices for the 
		// different frame starts. (*1)

	} // LAYERS_DATABASE;

	//
	//	ANIM
	//

	static private class ANIM {

		LAYERS_DATABASE layersDatabase;
		
		// should replace these with start indices into other tables. (*1)
		
		short frame_StartIndex[];
		byte frame_LayerCount[];
		
		// what about these?
		
		byte on_bits[];
		byte off_bits[];
		
		// what about > 127 frame animations

		byte last_frame;

	} // ANIM;

