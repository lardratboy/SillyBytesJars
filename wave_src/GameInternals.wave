// ----------------------------------------------------------------------------

	static private class game_ENTITY_INFO {

		// --------------------------------------------------------------------
		// animation table (should this be done elsewhere?)
		// possibly a 'state' related animation database?
		// animations[ state ][ type ][ dir ] = animation?
		// to handle more complex games a sparse database would be needed.
		// --------------------------------------------------------------------

		short anim_l;						// left visuals
		short anim_r;						// right visuals
		short anim_u;						// up visuals
		short anim_d;						// down visuals

		short root_l;						// root left visuals
		short root_r;						// root right visuals
		short root_u;						// root up visuals
		short root_d;						// root down visuals

		// general settings

		short entity_speed;					// used to control movement speed
		short type;							// what type of entity is this (goon, hero, goal?)
		short default_movement_type;		// how does the entity move

		// --------------------------------------------------------------------
		// health related entries
		// --------------------------------------------------------------------

		short initial_health;				// initial health value
		short healing_rate;					// how much the health increase to the max health value
		short hit_by_player_damage;			// how does this entities health change by touching player.
		short max_health;					// the health upper limit for this entity
		short hit_the_player_damage;		// how much damage this does to the player

		// --------------------------------------------------------------------
		// new settings
		// --------------------------------------------------------------------

		short sort_priority;
		short change_type_to_upon_death;
		short change_type_to_upon_collision;

		// --------------------------------------------------------------------
		// sounds settings
		// --------------------------------------------------------------------
		
		byte on_create_sound;
		byte on_destroy_sound;
		
		// --------------------------------------------------------------------
		// entity class related info
		// --------------------------------------------------------------------
		
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)
		
		short class_bits;					// entity class bits
		byte class_value_render_type;		// how to render the class value
		short class_value_animation;		// what animation to use for the visualization
		int class_value_min;				// min value allowed in entity class value
		int class_value_max;				// max value allowed in entity class value
		int class_value_default;			// initial class value for entity

#endif // class value added (8/31/03)

		// --------------------------------------------------------------------
		
		short flags;						// general flags for entities
		
		// --------------------------------------------------------------------
		
	} // game_ENTITY_INFO

	// ------------------------------------------------------------------------

	//
	//	game_ENTITY
	//

#define game_ENTITY_BOUNCED							0x0001
#define game_ENTITY_BUTTON_DOWN						0x0002
#define game_ENTITY_PENDING_TILE_ACTION				0x0004
#define game_ENTITY_CHANGE_DIRECTION				0x0008
#define game_ENTITY_PICKED_UP						0xC010
#define game_ENTITY_DEAD							0x8020
#define game_ENTITY_CURRENT_TILE_PENDING_ACTION		0x0040
#define game_ENTITY_ANY_PENDING_TILE_ACTION			0x0044
#define game_ENTITY_USING_ROOT_ANIMATION			0x0080
#define game_ENTITY_CAPTURED						0x2000
#define game_ENTITY_COLLIDED						0x4000
#define game_ENTITY_NOT_ACTIVE						0x8000

/*

	All of these really should be seperated into array form, this
	not only will help reduce the memory foot print, it will allow
	these to be indexed as properties and this will allow for tile <-> entity
	and entity <-> settings to be defined more abstractly!
	
	Need to come up with a general structure definition system that abstracts the
	process of how these things are referenced!  

*/

	static private class game_ENTITY {

		// data
		// --------------------------------------------------------------------

		short x;							// current x position (pixel)
		short y;							// current y position (pixel)

		short map_x;						// what map position is this
		short map_y;						// what map position is this

		short way_x;						// where is the entity going?
		short way_y;						// where is the entity going?

		short delta_x;						// per frame movement delta
		short delta_y;						// per frame movement delta

		short entity_type;					// what is the type of this entity
		short next_entity_link;				// prize link (if player it's the head of list)

		short health;						// what is the health of this entity
		int flags;							// flags collection

		int rndGeneratorData;				// data needed for this entities random generator
		int pendingDirection;				// is there a pending direction change?

		ANIM_STATE_POLICY_DECLARE( animState )
		
		short movement_type;				// how does this entity instance move

		// --------------------------------------------------------------------
		// entity class related info
		// --------------------------------------------------------------------
		
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

		int class_value;					// current 'class' value
		
#endif // class value added (8/31/03)

		// --------------------------------------------------------------------
		
	} // game_ENTITY
	
