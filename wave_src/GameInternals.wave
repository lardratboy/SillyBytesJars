		int frame;

		// misc
		// --------------------------------------------------------------------

		ANIM_STATE_POLICY_DECLARE( backgroundAnimState )
		
		ANIM_STATE_POLICY_DECLARE( overlayAnimState )
		
		ANIM_STATE_POLICY_DECLARE( scoreboardAnimState )

		// data tables
		// --------------------------------------------------------------------

		game_ENTITY_INFO entityInfoTable[];

		game_TILE_INFO tileInfoTable[];

		// histogram tables
		// --------------------------------------------------------------------

#if defined(GAME_USES_TILE_HISTOGRAM_INFO)

		short tileTypeHistogram[];

#endif // defined(GAME_USES_TILE_HISTOGRAM_INFO)

		short entityTypeHistogram[];

		// --------------------------------------------------------------------

		byte entitiesThatCanCollectThings[];

		short collectorEntityCount;

		// --------------------------------------------------------------------
		// input stream related
		// --------------------------------------------------------------------

		short inputStreams[] = new short [ MAX_INPUT_STREAMS ];

		short inputStreamFramesTable[] = new short [ 64 ];
		
		byte inputStreamFrameCmdCount[] = new byte [ 64 ];
		
		byte inputWhichStreamTable[] = new byte [ 128 ];
		
		short inputCommandBitsTable[] = new short [ 128 ];
		
		short intputStreamFrameCount;
		
		short inputStreamFrameIndex;
		
		short inputStreamCmdIndex;
		
		short inputStreamFrame;
				
		// --------------------------------------------------------------------
		// FOOD CHAIN SPECIFIC CODE
		// --------------------------------------------------------------------
		
#if defined(FOOD_CHAIN_CAGE_INFO)

		CagedAndAnimalInfo foodchain_CagedAnimalsInformation[];
		
		byte foodchain_CagedAnimalCount;
		
		Vector foodchain_SpecialEntities = new Vector( 2 );
		
		byte foodchain_NextCage;
		
		byte foodchain_CurrentCage;

#endif // defined(FOOD_CHAIN_CAGE_INFO)
		
		// --------------------------------------------------------------------
		// load from file
		// --------------------------------------------------------------------
		
		//
		//	Load()
		//
		
		boolean Load( String filename, boolean bUseHttp ) {
		
			CFileReader inFile = null;
			
			try {
			
				inFile = new CFileReader();
				
				if ( !inFile.Open( filename, bUseHttp ) ) {
				
					inFile = null;
					return false;
			
				}
				
				int chunkSize = inFile.Read_16();
				
				// ----------------------------------------------------------------
				
				inFile.Read_Validate_DECAFBAD();
				
				// ----------------------------------------------------------------
				
				framesPerSecond = inFile.Read_Flexible_16();
				
				entityCollisionDistance = (byte)inFile.ReadByte();

				// ----------------------------------------------------------------

				maxActiveEntities = inFile.Read_Flexible_16();
				int maxBoardElements = inFile.Read_Flexible_16();
				
				GAME_TILE_PIXELS_CX = inFile.Read_Flexible_16();
				GAME_TILE_PIXELS_CY = inFile.Read_Flexible_16();

				// background / foreground animation
				// ------------------------------------------------------------
				
				ANIM_STATE_POLICY_ACCESS(backgroundAnimState,animation) = inFile.Read_Flexible_16();
				ANIM_STATE_POLICY_ACCESS(overlayAnimState,animation) = inFile.Read_Flexible_16();
				ANIM_STATE_POLICY_ACCESS(scoreboardAnimState,animation) = inFile.Read_Flexible_16();

				// cursor information
				// ------------------------------------------------------------
				
				{
					short cursorAnim = inFile.Read_Flexible_16();
					
#if defined(GAME_HAS_A_TILE_CURSOR)

					ANIM_STATE_POLICY_ACCESS(cursor_animstate,animation) = cursorAnim;
					
#endif // defined(GAME_HAS_A_TILE_CURSOR)

					if ( 0 != cursorAnim ) {
					
#if defined(GAME_HAS_A_TILE_CURSOR)

						cursor_flags = inFile.Read_Flexible_16();
						
						cursor_repeat_rate = inFile.Read_Flexible_16();

#else
						
						inFile.Read_Flexible_16();
						
						inFile.Read_Flexible_16();
						
#endif // defined(GAME_HAS_A_TILE_CURSOR)
						
					}

				}

				// construct the map storage
				// ----------------------------------------------------------------

				map = new short [ maxBoardElements ];
				map_condition_8s = new byte [ maxBoardElements ];

#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

				// ------------------------------------------------------------

				map_flags = new short [ maxBoardElements ];
				
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

				map_tile_left_reach = new byte [ maxBoardElements ];
		
				map_tile_top_reach = new byte [ maxBoardElements ];

				map_tile_right_reach = new byte [ maxBoardElements ];
		
				map_tile_bottom_reach = new byte [ maxBoardElements ];
				
				// ------------------------------------------------------------
				
				clippingRectangles = new AnimationEngine.CLIP_RECTANGLE [ 8 ];
				
				for ( int nRect = 8; 0 <= --nRect; ) {
				
					clippingRectangles[ nRect ] = new AnimationEngine.CLIP_RECTANGLE();
				
				}
				
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

				// construct the active entity related 
				// ----------------------------------------------------------------
				
				entitiesThatCanCollectThings = new byte [ maxActiveEntities ];

				entities = new game_ENTITY[ maxActiveEntities ];

				entityRenderOrder = new game_ENTITY_SORT_HELPER[ entities.length ];

				for ( int i = 0; i < entities.length; i++ ) {

					entities[ i ] = new game_ENTITY();

					entityRenderOrder[ i ] = new game_ENTITY_SORT_HELPER();

				}

				// ----------------------------------------------------------------
				
				int uniqueTileTypes = inFile.Read_Flexible_16();
				
				tileInfoTable = new game_TILE_INFO[ uniqueTileTypes ];

#if defined(GAME_USES_TILE_HISTOGRAM_INFO)

				tileTypeHistogram = new short [ uniqueTileTypes ];
				
#endif // defined(GAME_USES_TILE_HISTOGRAM_INFO)

				inFile.Read_Validate_16( (short)0xDEAD );
					
				for ( int i = 0; i < tileInfoTable.length; i++ ) {

					tileInfoTable[ i ] = new game_TILE_INFO();
					tileInfoTable[ i ].change_to = inFile.Read_Flexible_16();
					tileInfoTable[ i ].ANIM_STATE_POLICY_ACCESS(animState,animation) = inFile.Read_Flexible_16();
					tileInfoTable[ i ].ANIM_STATE_POLICY_ACCESS(animState,frame) = inFile.Read_Flexible_16();
					tileInfoTable[ i ].flags = inFile.Read_32();
					tileInfoTable[ i ].action_type = inFile.Read_Flexible_16();
					
					// --------------------------------------------------------

#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

					tileInfoTable[ i ].left_reach = (byte)inFile.ReadByte();
					tileInfoTable[ i ].top_reach = (byte)inFile.ReadByte();
					tileInfoTable[ i ].right_reach = (byte)inFile.ReadByte();
					tileInfoTable[ i ].bottom_reach = (byte)inFile.ReadByte();
					
#else

					inFile.ReadByte();
					inFile.ReadByte();
					inFile.ReadByte();
					inFile.ReadByte();

#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

					// --------------------------------------------------------
					
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

					tileInfoTable[ i ].class_value_test_type = (byte)inFile.ReadByte();
					tileInfoTable[ i ].on_action_create_entity = inFile.Read_Flexible_16();
					
					if ( CLASS_VALUE_TEST_TYPE_NONE != tileInfoTable[ i ].class_value_test_type ) {
					
						tileInfoTable[ i ].class_value_gateway_bits = inFile.Read_Flexible_16();		// 1
						tileInfoTable[ i ].class_value_test_bits = inFile.Read_Flexible_16();			// 2
				
						tileInfoTable[ i ].on_class_true_add = inFile.Read_Flexible_16();				// 3
						tileInfoTable[ i ].on_class_true_multiplier = inFile.Read_Flexible_16();		// 4
						tileInfoTable[ i ].on_class_true_create_entity = inFile.Read_Flexible_16();		// 5

						tileInfoTable[ i ].on_class_false_add = inFile.Read_Flexible_16();				// 6
						tileInfoTable[ i ].on_class_false_multiplier = inFile.Read_Flexible_16();		// 7
						tileInfoTable[ i ].on_class_false_create_entity = inFile.Read_Flexible_16();	// 8
						
					}
					
#else

					// simply skip over the extra data stored in the files.
					
					int class_value_test_bits = inFile.ReadByte();
					
					inFile.Read_Flexible_16(); // on_action_create_entity
					
					if ( CLASS_VALUE_TEST_TYPE_NONE != class_value_test_bits ) {
					
						for ( int extra = 8; 0 <= --extra; ) {
						
							inFile.Read_Flexible_16();
						
						}
						
					}
					
#endif // class value added (8/31/03)

					// --------------------------------------------------------
					
	//System.out.println( "tile " + i + " anim " + tileInfoTable[ i ].ANIM_STATE_POLICY_ACCESS(animState,animation) + " frame " + tileInfoTable[ i ].ANIM_STATE_POLICY_ACCESS(animState,frame) );

				}

				inFile.Read_Validate_16( (short)0xBEEF );
				
				// ----------------------------------------------------------------
				
				int nEntityTypes = inFile.Read_Flexible_16();

				entityInfoTable = new game_ENTITY_INFO[ nEntityTypes ];

				entityTypeHistogram = new short [ GAME_ENTITY_INFO_TYPE_LAST_TYPE + 1 ]; // bug fix was nEntityTypes ];

				inFile.Read_Validate_16( (short)0xDEAD );
					
				for ( int i = 0; i < entityInfoTable.length; i++ ) {

					entityInfoTable[ i ] = new game_ENTITY_INFO();
					
					game_ENTITY_INFO entityInfo = entityInfoTable[ i ];
					
					// this should be an animation table!
					// ------------------------------------------------------------
					
					inFile.ReadByte(); // skip the count for now...
					
					entityInfo.anim_l							= inFile.Read_Flexible_16();
					entityInfo.anim_r							= inFile.Read_Flexible_16();
					entityInfo.anim_u							= inFile.Read_Flexible_16();
					entityInfo.anim_d							= inFile.Read_Flexible_16();
					entityInfo.root_l							= inFile.Read_Flexible_16();
					entityInfo.root_r							= inFile.Read_Flexible_16();
					entityInfo.root_u							= inFile.Read_Flexible_16();
					entityInfo.root_d							= inFile.Read_Flexible_16();
					
					// ------------------------------------------------------------
					
					entityInfo.entity_speed						= inFile.Read_Flexible_16();
					entityInfo.type								= inFile.Read_Flexible_16();
					entityInfo.default_movement_type			= inFile.Read_Flexible_16();
					entityInfo.initial_health					= inFile.Read_Flexible_16();
					entityInfo.healing_rate						= inFile.Read_Flexible_16();
					entityInfo.hit_by_player_damage				= inFile.Read_Flexible_16();
					entityInfo.max_health						= inFile.Read_Flexible_16();
					entityInfo.hit_the_player_damage			= inFile.Read_Flexible_16();
					entityInfo.sort_priority					= inFile.Read_Flexible_16();
					entityInfo.change_type_to_upon_death		= inFile.Read_Flexible_16();
					entityInfo.change_type_to_upon_collision	= inFile.Read_Flexible_16();
					
					// --------------------------------------------------------
					
					entityInfo.on_create_sound					= (byte)inFile.ReadByte();
					entityInfo.on_destroy_sound					= (byte)inFile.ReadByte();

					// --------------------------------------------------------

#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)
		
					entityInfo.class_bits						= inFile.Read_Flexible_16();
					entityInfo.class_value_render_type			= (byte)inFile.ReadByte();
					entityInfo.class_value_animation			= inFile.Read_Flexible_16();
					entityInfo.class_value_min					= inFile.Read_32();
					entityInfo.class_value_max					= inFile.Read_32();
					entityInfo.class_value_default				= inFile.Read_32();
					
#else

					inFile.Read_Flexible_16();
					inFile.ReadByte();
					inFile.Read_Flexible_16();
					inFile.Read_32();
					inFile.Read_32();
					inFile.Read_32();

#endif // class value added (8/31/03)

					// --------------------------------------------------------
					
					entityInfo.flags							= inFile.Read_Flexible_16(); // 9/26/03
					
					// --------------------------------------------------------
					
				}
				
				inFile.Read_Validate_16((short)0xBEEF);
					
				// ------------------------------------------------------------
		
#if defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				remap_EntityTableSize = (byte)inFile.ReadByte();
				
				if ( 0 != remap_EntityTableSize ) {
				
					remap_SrcEntity = new byte [ remap_EntityTableSize ];
					
					remap_DstEntity = new byte [ remap_EntityTableSize ];
				
					// --------------------------------------------------------

					inFile.Read_Validate_16( (short)0xDEAD );
					
					for ( int j = remap_EntityTableSize; 0 <= --j; ) {
					
						remap_SrcEntity[ j ] = (byte)inFile.ReadByte();
						
						remap_DstEntity[ j ] = (byte)inFile.ReadByte();
						
						DBUG_TRACE_ENTITY_REMAPPING( "Remap Entity " + remap_SrcEntity[ j ] + " to " + remap_DstEntity[ j ] );
					
					}
					
					inFile.Read_Validate_16(( short)0xBEEF );
					
				}
				
#else
				
				int remapEntries = (byte)inFile.ReadByte();
				
				if ( 0 != remapEntries ) {
				
					inFile.Read_Validate_16( (short)0xDEAD );
					
					while ( 0 <= --remapEntries ) {
					
						inFile.ReadByte();
						
						inFile.ReadByte();
						
					}
					
					inFile.Read_Validate_16( (short)0xBEEF );
					
				}
				
#endif // defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				// ------------------------------------------------------------
				
			} catch ( Throwable e ) {
			
				REPORT_EXCEPTION_POLICY( e, EXCEPTION_GAMESTATE_LOAD );
				
				return false;
				
			} finally {
			
				if ( null != inFile ) {
				
					inFile.Close();
					inFile = null;
				
				}
				
			}
							
			// ----------------------------------------------------------------
			
			DBUG_TRACE_LOAD( "loaded setup!" );
			
			bValid = true;
			
			MarkEntireBackgroundAsChanged();
			
			return true;			
		}
		
		// ====================================================================
		
		//
		//	LoadLevelCatalogData()
		//
		
		boolean LoadLevelCatalogData( String filename, boolean bUseHttp ) {
		
			CFileReader inFile = null;
			
			try {
			
				inFile = new CFileReader();
				
				if ( !inFile.Open( filename, bUseHttp ) ) {
				
					inFile = null;
					return false;
			
				}
				
				int chunkSize = inFile.Read_16();
				
				// ----------------------------------------------------------------
				
				inFile.Read_Validate_DECAFBAD();
				
				// ----------------------------------------------------------------
				
				int nLevels = inFile.ReadByte();

				level_data_type = new byte [ nLevels ];
								
				level_data_cut_scene = new byte [ nLevels ];
				
				level_data_next = new byte [ nLevels ];
								
				// ----------------------------------------------------------------

				inFile.Read_Validate_16( (short)0xDEAD );
				
				for ( int i = 0; i < nLevels; i++ ) {
				
					level_data_type[ i ] = (byte)inFile.ReadByte();
					
					level_data_cut_scene[ i ] = (byte)inFile.ReadByte();
					
					level_data_next[ i ] = (byte)inFile.ReadByte();
					
					DBUG_TRACE_LOAD( "level" + i );
					DBUG_TRACE_LOAD( "\ttype = " + level_data_type[ i ] );
					DBUG_TRACE_LOAD( "\tcut_scene = " + level_data_cut_scene[ i ] );
					DBUG_TRACE_LOAD( "\tnext = " + level_data_next[ i ] );
				
				}
				
				inFile.Read_Validate_16((short)0xBEEF);
				
			} catch ( Throwable e ) {
			
				REPORT_EXCEPTION_POLICY( e, EXCEPTION_CATALOG_LOAD );
				
				return false;
				
			} finally {
			
				if ( null != inFile ) {
				
					inFile.Close();
					inFile = null;
				
				}
			}
							
			// ----------------------------------------------------------------
			
			DBUG_TRACE_LOAD( "loaded catalog!" );
			
			return true;			
			
		}
				
	} // game_STATE;

	// ========================================================================
	// internal methods
	// ========================================================================

	//
	//	EntityRandNumber()
	//

	INTERNAL_METHOD( int )
	EntityRandNumber(
		game_ENTITY entity
	) {
	
		// minimal standard linear congruential generator
		// Xn+1 = (a * Xn + c) mod m
		// a = 16807, c = 0, m = (1 << 31) - 1
		// http://www.taygeta.com/rwalks/node1.html

		int xn = entity.rndGeneratorData;

		entity.rndGeneratorData = (xn * 16807) & 0x7FFFFFFF;	// (a * xn) % m

		return xn >> 8;
	}
	
	//
	//	QueueSound()
	//
	
	INTERNAL_METHOD( void )
	QueueSound( int sound ) {
	
		if ( policy_Sounds ) {
	
			currentSoundManager.Queue( sound );
			
		}
		
	}

	// ------------------------------------------------------------------------
	// DEAL WITH ENTITY TYPE CHANGE!!!!
	// ------------------------------------------------------------------------

	//
	//	ChangeEntityToType()
	//

	INTERNAL_METHOD( void )
	ChangeEntityToType(
		game_ENTITY entity
		,short newEntityType
		,boolean bStopAndCenter
	) {

		// --------------------------------------------------------------------
		
		if ( bStopAndCenter ) {
		
			entity.x = (short)((entity.map_x * GAME_TILE_PIXELS_CX) + GAME_TILE_PIXELS_CX/2);
			entity.y = (short)((entity.map_y * GAME_TILE_PIXELS_CY) + GAME_TILE_PIXELS_CY/2);
			entity.delta_x = 0;
			entity.delta_y = 0;
			entity.way_x = entity.x;
			entity.way_y = entity.y;

		}

		// --------------------------------------------------------------------
		
		int old_entity_type = entity.entity_type;
		entity.entity_type = newEntityType;
		
		game_ENTITY_INFO newEntityInfo = gameState.entityInfoTable[ newEntityType ];

		short newAnim = newEntityInfo.anim_d;
		entity.ANIM_STATE_POLICY_ACCESS(animState,animation) = newAnim;
		entity.ANIM_STATE_POLICY_ACCESS(animState,frame) = 0;
		entity.ANIM_STATE_POLICY_ACCESS(animState,conditions_8) = 0;
		entity.flags = 0;
		entity.rndGeneratorData = ((newEntityType * 7) + newEntityType) + 1;
		
#if !defined(OLD_RND_GENERATOR_SEED_POLICY)
		entity.rndGeneratorData += (entity.map_x + (entity.map_y * gameState.active_w));
#endif

		entity.pendingDirection = 0;
		entity.health = newEntityInfo.initial_health;
		entity.movement_type = newEntityInfo.default_movement_type;

#if !defined(USE_ANIM_STATE_CLASS)

		entity.ANIM_STATE_POLICY_ACCESS(animState,last_frame) = currentAnimEngine.LastFrame( newAnim );
			
#endif

		// --------------------------------------------------------------------
		// entity class related info
		// --------------------------------------------------------------------
		
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

		if ( 0 == (ENTITY_INFO_FLAG_KEEP_CLASS_VALUE_ON_CHANGE & newEntityInfo.flags) ) {
		
			entity.class_value = newEntityInfo.class_value_default;
		
		} else {
		
			if ( newEntityInfo.class_value_min > entity.class_value ) {
			
				entity.class_value = newEntityInfo.class_value_min;
				
			}
		
			if ( newEntityInfo.class_value_max < entity.class_value ) {
			
				entity.class_value = newEntityInfo.class_value_max;
				
			}
			
		}

#endif // class value added (8/31/03)

		// --------------------------------------------------------------------
		
		SyncEntityToCurrentState( entity );
		
		// --------------------------------------------------------------------
		// play audio here?
		// --------------------------------------------------------------------

		if ( newEntityType != old_entity_type ) {
		
			if ( 0 != gameState.entityInfoTable[ old_entity_type ].on_destroy_sound ) {

				QueueSound(
					gameState.entityInfoTable[ old_entity_type ].on_destroy_sound
				);

			}
			
			if ( 0 != newEntityInfo.on_create_sound ) {

				QueueSound(
					newEntityInfo.on_create_sound
				);

			}

		}
		
	}

	// ------------------------------------------------------------------------

	//
	//	SyncEntityToCurrentState()
	//

	INTERNAL_METHOD( void )
	SyncEntityToCurrentState(
		game_ENTITY entity
	) {
		game_ENTITY_INFO entityInfo = gameState.entityInfoTable[ entity.entity_type ];

		// deal with type change?
		// --------------------------------------------------------------------

		if ( game_ENTITY_DEAD == (game_ENTITY_DEAD & entity.flags) ) {
		
			if ( -1 != entityInfo.change_type_to_upon_death ) {

				ChangeEntityToType( entity, entityInfo.change_type_to_upon_death, false );
				
			} else if ( 0 != entityInfo.on_destroy_sound ) {

				QueueSound( entityInfo.on_destroy_sound );

			}

		}
			
		if ( game_ENTITY_COLLIDED == (game_ENTITY_COLLIDED & entity.flags) ) {
		
			if ( -1 != entityInfo.change_type_to_upon_collision ) {

				ChangeEntityToType( entity, entityInfo.change_type_to_upon_collision, false );
				
			} else if ( 0 != entityInfo.on_destroy_sound ) {

				QueueSound( entityInfo.on_destroy_sound );

			}
			
		}

		// didn't have to do a type change simply handle animation...
		// --------------------------------------------------------------------

		short oldAnim = entity.ANIM_STATE_POLICY_ACCESS(animState,animation);

		short newAnim = oldAnim;
		
		int oldFlags = entity.flags;
		
		entity.flags &= ~game_ENTITY_USING_ROOT_ANIMATION;

		if ( 0 >  entity.delta_x ) {

			newAnim = entityInfo.anim_l;

		} else if ( 0 < entity.delta_x ) {

			newAnim = entityInfo.anim_r;

		} else if ( 0 > entity.delta_y ) {

			newAnim = entityInfo.anim_u;

		} else if ( 0 < entity.delta_y ) {

			newAnim = entityInfo.anim_d;

		} else {

			// root/stand

			entity.flags |= game_ENTITY_USING_ROOT_ANIMATION;
			
			if ( oldAnim == entityInfo.anim_l ) {

				newAnim = entityInfo.root_l;

			} else if ( oldAnim == entityInfo.anim_r ) {

				newAnim = entityInfo.root_r;
				
			} else if ( oldAnim == entityInfo.anim_u ) {

				newAnim = entityInfo.root_u;
				
			} else if ( oldAnim == entityInfo.anim_d ) {

				newAnim = entityInfo.root_d;
				
			}

		}
		
		if ( (newAnim != oldAnim) ||
			((game_ENTITY_USING_ROOT_ANIMATION & oldFlags) != (game_ENTITY_USING_ROOT_ANIMATION & entity.flags))
			) {

			entity.ANIM_STATE_POLICY_ACCESS(animState,animation) = (short)newAnim;

			entity.ANIM_STATE_POLICY_ACCESS(animState,frame) = 0;
			
#if !defined(USE_ANIM_STATE_CLASS)

			entity.ANIM_STATE_POLICY_ACCESS(animState,last_frame) = currentAnimEngine.LastFrame( newAnim );

#endif

		}

	}

	// ------------------------------------------------------------------------
	// ROTATE ACTION FOR PIECE
	// ------------------------------------------------------------------------

	//
	//	RotateEntitiesOnPiece
	//
	//	NOTE: This function is only valid for 90 rotates (right) if other
	//	piece change types are done then this function needs to be renamed and
	//	rewritten!
	//

	INTERNAL_METHOD( void )
	RotateEntitiesOnPiece(
		short map_x
		,short map_y
	) {
		short centerX = (short)((map_x * GAME_TILE_PIXELS_CX) + (GAME_TILE_PIXELS_CX/2));

		short centerY = (short)((map_y * GAME_TILE_PIXELS_CY) + (GAME_TILE_PIXELS_CY/2));

		for ( short i = 0; i < gameState.activeEntities; i++ ) {

			game_ENTITY entity = gameState.entities[ i ];

			if ( (map_x == entity.map_x) && (map_y == entity.map_y) ) {

				// rotate (R) position

				int tx = entity.x - centerX;
				int ty = entity.y - centerY;

				entity.x = (short)(centerX - ty);
				entity.y = (short)(centerY + tx);

				// rotate (R) delta

				tx = entity.delta_x;
				ty = entity.delta_y;

				entity.delta_x = (short)-ty;
				entity.delta_y = (short)tx;

				// rotate (R) way point

				tx = entity.way_x - centerX;
				ty = entity.way_y - centerY;

				entity.way_x = (short)(centerX - ty);
				entity.way_y = (short)(centerY + tx);

				// deal with the entity animation (need a table!)

				game_ENTITY_INFO entityInfo = gameState.entityInfoTable[ entity.entity_type ];

				short oldAnim = entity.ANIM_STATE_POLICY_ACCESS(animState,animation);
				
				short newAnim = oldAnim;

				if ( oldAnim == entityInfo.anim_u ) {

					newAnim = entityInfo.anim_r;

				} else if ( oldAnim == entityInfo.anim_r ) {

					newAnim = entityInfo.anim_d;

				} else if ( oldAnim == entityInfo.anim_d ) {

					newAnim = entityInfo.anim_l;

				} else if ( oldAnim == entityInfo.anim_l ) {

					newAnim = entityInfo.anim_u;

				} else if ( oldAnim == entityInfo.root_u ) {

					newAnim = entityInfo.root_r;

				} else if ( oldAnim == entityInfo.root_r ) {

					newAnim = entityInfo.root_d;

				} else if ( oldAnim == entityInfo.root_d ) {

					newAnim = entityInfo.root_l;

				} else if ( oldAnim == entityInfo.root_l ) {

					newAnim = entityInfo.root_u;

				}

				if ( newAnim != oldAnim ) {

					entity.ANIM_STATE_POLICY_ACCESS(animState,animation) = newAnim;

					entity.ANIM_STATE_POLICY_ACCESS(animState,frame) = 0;

#if !defined(USE_ANIM_STATE_CLASS)

					entity.ANIM_STATE_POLICY_ACCESS(animState,last_frame) = currentAnimEngine.LastFrame( newAnim );

#endif
				}

			}

		}
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	CreateEntityTypeAt()
	//
	
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

	INTERNAL_METHOD( void )
	CreateEntityTypeAt(
		int createEntityType
		,int map_x
		,int map_y
		,boolean bOverrideClassValue
		,int override_class_value
	) {
	
		// find a available entity slot (this should be a stack!)
		// and the active elements should be a linked list!!!!
		// --------------------------------------------------------------------
		
		int availableEntitySlot = -1;
		
		for ( int i = gameState.activeEntities; 0 <= --i; ) {
		
			if ( 0 != (game_ENTITY_DEAD & gameState.entities[ i ].flags) ) {
			
				availableEntitySlot = i;
				
				break;
			
			}
		
		}
		
		if ( (-1 == availableEntitySlot) && (gameState.maxActiveEntities > gameState.activeEntities) ) {
		
			availableEntitySlot = gameState.activeEntities;
		
			++gameState.activeEntities;
			
		}
		
		// --------------------------------------------------------------------

		if ( -1 == availableEntitySlot ) {
		
			return;
		
		}
		
		InitializeEntityAt(
			gameState.entities[ availableEntitySlot ]
			,(short)createEntityType
			,(short)map_x
			,(short)map_y
			,(short)0
			,true
			,bOverrideClassValue
			,override_class_value
		);
		
	}
	
#endif // class value added (8/31/03)

	//
	//	TeleportEntitiesOnTile()
	//
	
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

	INTERNAL_METHOD( void )
	TeleportEntitiesOnTile( int mapIndex, int map_x, int map_y, game_TILE_INFO tileInfo ) {
	
		// find the target tile
		// --------------------------------------------------------------------
	
		game_TILE_INFO targetTileInfo = null;
		
		int targetIndex = 0;

		{
		
		FOUND_TARGET_LABEL:
		
			for ( int y = 0; y < gameState.active_h; y++ ) {

				for ( int x = 0; x < gameState.active_w; x++, targetIndex++ ) {
				
					if ( targetIndex == mapIndex ) continue;

					game_TILE_INFO info = gameState.tileInfoTable[ (gameState.map[ targetIndex ]) ];
					
					if ( info.action_type == tileInfo.action_type ) {
					
						targetTileInfo = info;
					
						break FOUND_TARGET_LABEL;
					
					}
					
				}
				
			}
			
			if ( null == targetTileInfo ) {
			
				return;
			
			}
			
		}
		
		short target_y = (short)(targetIndex / gameState.active_w);
		
		short target_x = (short)(targetIndex % gameState.active_w);
		
		short targetCenter_x = (short)((target_x * GAME_TILE_PIXELS_CX) + (GAME_TILE_PIXELS_CX/2));

		short targetCenter_y = (short)((target_y * GAME_TILE_PIXELS_CY) + (GAME_TILE_PIXELS_CY/2));

		// --------------------------------------------------------------------
		
		boolean bTeleportedSomething = false;
		
		for ( int i = 0; i < gameState.activeEntities; i++ ) {

			game_ENTITY entity = gameState.entities[ i ];

			if ( (map_x == entity.map_x) && (map_y == entity.map_y) ) {
			
				entity.map_x = target_x;
				entity.map_y = target_y;
				
				entity.x = targetCenter_x;
				entity.y = targetCenter_y; 
			
				entity.way_x = targetCenter_x;
				entity.way_y = targetCenter_y;
				
				entity.delta_x = 0;
				entity.delta_y = 0;
			
				bTeleportedSomething = true;
			
			}
			
		}
		
		// Check to see if there is an 'action' entity that needs
		// to be produced.
		// --------------------------------------------------------
		
		if ( bTeleportedSomething && (-1 != tileInfo.on_action_create_entity) ) {
		
			CreateEntityTypeAt(
				tileInfo.on_action_create_entity
				,target_x
				,target_y
				,false
				,0
			);
		
		}
		
	}
	
#endif // class value added (8/31/03)

	// ------------------------------------------------------------------------
	
	//
	//	PerformActionOnMapLocation()
	//
	
	INTERNAL_METHOD( void )
	PerformActionOnMapLocation( int mapIndex, int map_x, int map_y, game_TILE_INFO tileInfo ) {
	
		// change the tile
		
		if ( tileInfo.change_to != gameState.map[ mapIndex ] ) {

			gameState.map[ mapIndex ] = tileInfo.change_to;

			gameState.bPlayfieldChanged = true;
			
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			gameState.map_flags[ mapIndex ] = MAP_FLAG_TILE_CHANGED;
			
			// ----------------------------------------------------------------
			
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

			game_TILE_INFO newTileInfo = gameState.tileInfoTable[ tileInfo.change_to ];

			gameState.map_tile_left_reach[ mapIndex ] =
				(newTileInfo.left_reach > tileInfo.left_reach) ? newTileInfo.left_reach : tileInfo.left_reach;

			gameState.map_tile_top_reach[ mapIndex ] =
				(newTileInfo.top_reach > tileInfo.top_reach) ? newTileInfo.top_reach : tileInfo.top_reach;

			gameState.map_tile_right_reach[ mapIndex ] =
				(newTileInfo.right_reach > tileInfo.right_reach) ? newTileInfo.right_reach : tileInfo.right_reach;

			gameState.map_tile_bottom_reach[ mapIndex ] =
				(newTileInfo.bottom_reach > tileInfo.bottom_reach) ? newTileInfo.bottom_reach : tileInfo.bottom_reach;
				
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
		
			// ----------------------------------------------------------------
			
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

		}

		// check to see if the entities should be rotated

		if ( 0 != (GAME_TILE_INFO_ACTION_ROTATE_ENTITIES & tileInfo.flags) ) {

			RotateEntitiesOnPiece( (short)map_x, (short)map_y );

		}

		// Perform other lower priority actions
		// --------------------------------------------------------
	
		if ( (tileInfo.action_type >= TILE_ACTION_GOTO_LEVEL_1) &&
			(tileInfo.action_type <= TILE_ACTION_GOTO_LEVEL_100) &&
			(0 != (0x01 & gameState.map_condition_8s[ mapIndex ])) ) {
			
			gameState.requestLevelChange = (byte)(
				(tileInfo.action_type - TILE_ACTION_GOTO_LEVEL_1) + 1
			);
			
		}
		
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

		else if ( (tileInfo.action_type >= TILE_ACTION_TELEPORTER_1) &&
			(tileInfo.action_type <= TILE_ACTION_TELEPORTER_8) ) {
			
			TeleportEntitiesOnTile( mapIndex, map_x, map_y, tileInfo );
			
		}
		
		// Check to see if there is an 'action' entity that needs
		// to be produced.
		// --------------------------------------------------------
		
		if ( -1 != tileInfo.on_action_create_entity ) {
		
			CreateEntityTypeAt(
				tileInfo.on_action_create_entity
				,map_x
				,map_y
				,false
				,0
			);
		
		}
	
#endif //class value added (8/31/03)
		
	}
	
	// ------------------------------------------------------------------------

	//
	//	PerformActionOnGroupedPieces()
	//

	INTERNAL_METHOD( void )
	PerformActionOnGroupedPieces(
		int inPlaceGroupBitFlags
		,boolean bMatchOnSharedBits
	) {

		int mapIndex = 0;
		
		game_TILE_INFO tileInfo;

		for ( short map_y = 0; map_y < gameState.active_h; map_y++ ) {

			for ( short map_x = 0; map_x < gameState.active_w; map_x++ ) {

				tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];

				boolean bPerformAction;

				if ( bMatchOnSharedBits ) {

					bPerformAction = (0 != ((GAME_TILE_INFO_GROUP_BITS_MASK & tileInfo.flags) & inPlaceGroupBitFlags));

				} else {

					bPerformAction = (inPlaceGroupBitFlags == (GAME_TILE_INFO_GROUP_BITS_MASK & tileInfo.flags));

				}

				if ( bPerformAction ) {

					PerformActionOnMapLocation( mapIndex, map_x, map_y, tileInfo );

				}

				++mapIndex;

			}

		}

	}

	// ------------------------------------------------------------------------

	//
	//	PerformActionOnBoardPiece()
	//

	INTERNAL_METHOD( void )
	PerformActionOnBoardPiece(
		short map_x
		,short map_y
	) {

		int mapIndex = (map_y * gameState.active_w) + map_x;

		short tileType = gameState.map[ mapIndex ];

		game_TILE_INFO tileInfo = gameState.tileInfoTable[ tileType ];

		// if the piece does rotate do so
		// --------------------------------------------------------------------

		int inPlaceGroupValue = (GAME_TILE_INFO_GROUP_BITS_MASK & tileInfo.flags);

		if ( 0 != inPlaceGroupValue ) {

			PerformActionOnGroupedPieces(
				inPlaceGroupValue
				,(0 != (GAME_TILE_INFO_GROUP_ACTION_ANY_SHARED & tileInfo.flags))
			);

		} else {

			PerformActionOnMapLocation( mapIndex, map_x, map_y, tileInfo );

		}

	}

	// ------------------------------------------------------------------------
	// ENTITY MANAGEMENT
	// ------------------------------------------------------------------------

	//
	//	CurrentDirectionFromDelta()
	//

	INTERNAL_METHOD( int )
	CurrentDirectionFromDelta(
		int dx
		,int dy
	) {
		if ( 0 > dx ) return GAME_TILE_INFO_L_OUT_CONNECT;

		if ( 0 < dx ) return GAME_TILE_INFO_R_OUT_CONNECT;

		if ( 0 > dy ) return GAME_TILE_INFO_U_OUT_CONNECT;

		if ( 0 < dy ) return GAME_TILE_INFO_D_OUT_CONNECT;

		return 0;
	}

	// ------------------------------------------------------------------------

	//
	//	CanEntityMoveToLocation()
	//

	INTERNAL_METHOD( boolean )
	CanEntityMoveToLocation(
		game_ENTITY entity
		,short map_x
		,short map_y
	) {
		// If the target isn't a valid map location bail out now
		// --------------------------------------------------------------------

		if ( (0 > map_x) || (0 > map_y) || (map_x >= gameState.active_w) ||
			(map_y >= gameState.active_h) ) {

			return false;

		}

		// Determine the map position delta and find the necessary incoming
		// direction needed for the next piece
		// --------------------------------------------------------------------

		int dx = map_x - entity.map_x;
		int dy = map_y - entity.map_y;

		if ( (0 == dx) && (0 == dy) ) {

			return true;

		}

		int neededDirectionBits = 0;

		if ( 0 > dx ) {

			neededDirectionBits = GAME_TILE_INFO_R_IN_CONNECT;

		} else if ( 0 < dx ) {

			neededDirectionBits = GAME_TILE_INFO_L_IN_CONNECT;

		}

		if ( 0 > dy ) {

			neededDirectionBits = GAME_TILE_INFO_D_IN_CONNECT;

		} else if ( 0 < dy ) {

			neededDirectionBits = GAME_TILE_INFO_U_IN_CONNECT;

		}

		// Now check the next map position to see if it has supports in
		// movement in that direction
		// --------------------------------------------------------------------
		
		int mapIndex = (map_y * gameState.active_w) + map_x;
		
		game_TILE_INFO tileInfo = gameState.tileInfoTable[ gameState.map[ mapIndex ] ];

		// --------------------------------------------------------------------
		
#if 1

		// Don't allow an entity to walk onto a locked level

		if ( (TILE_ACTION_GOTO_LEVEL_1 <= tileInfo.action_type) &&
			(TILE_ACTION_GOTO_LEVEL_100 >= tileInfo.action_type) &&
			(0 == (0x01 & gameState.map_condition_8s[ mapIndex ])) ) {
			
			return false;
			
		}
		
#endif
		
		// --------------------------------------------------------------------
		
		return (0 != (neededDirectionBits & tileInfo.flags));

	}

	// ------------------------------------------------------------------------
	
	//
	//	FOODCHAIN_ResetFoodTilesForEntity()
	//
	
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)
#if 1 // specific to the food chain game ?

	INTERNAL_METHOD( void )
	FOODCHAIN_ResetFoodTilesForEntity( game_ENTITY entity, game_ENTITY_INFO entityInfo ) {
	
		// --------------------------------------------------------------------
	
		int mapIndex = 0;
		
		boolean bTestResults;
		
		game_TILE_INFO tileInfo;
		
		for ( short map_y = 0; map_y < gameState.active_h; map_y++ ) {
		
			for ( short map_x = 0; map_x < gameState.active_w; map_x++, mapIndex++ ) {
			
				// ------------------------------------------------------------
				
				tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];
				
				if ( CLASS_VALUE_TEST_SPECIAL_INDICATOR >= tileInfo.class_value_test_type ) continue;
				
				// ------------------------------------------------------------

				bTestResults = false;

				switch ( tileInfo.class_value_test_type - CLASS_VALUE_TEST_SPECIAL_INDICATOR ) {

				case CLASS_VALUE_TEST_TYPE_EXACT:
					bTestResults = (
						entityInfo.class_bits == (entityInfo.class_bits & tileInfo.class_value_test_bits)
					);
					break;

				case CLASS_VALUE_TEST_TYPE_ANY:
					bTestResults = (
						0 != (entityInfo.class_bits & tileInfo.class_value_test_bits)
					);
					break;

				}
				
				// ------------------------------------------------------------
				
				if ( bTestResults ) {
				
					PerformActionOnBoardPiece( map_x, map_y );
				
				}
				
			}
			
		}
		
	}
									
#endif // specific to the food chain game
#endif // class value added (8/31/03)

	// ------------------------------------------------------------------------

	//
	//	ProcessEntities()
	//

	INTERNAL_METHOD( void )
	ProcessEntities() {

#if defined(OLD_ENTITY_TYPE_HISTOGRAM)

		// empty out the stats for the entity types
		// --------------------------------------------------------------------
		
		int len = gameState.entityTypeHistogram.length;

		for	( int i	= len; 0 <= --i; ) {

			gameState.entityTypeHistogram[ i ] = 0;

		}
		
#endif // defined(OLD_ENTITY_TYPE_HISTOGRAM)
		
		if ( 0 == gameState.activeEntities ) return;

		// Okay	now	process	all	the	entities (player is	the	first one)
		// --------------------------------------------------------------------

		// game_ENTITY	playerEntity = gameState.entities[ 0 ];

		int possibleChoices, addCount;
		
		game_TILE_INFO currentTileInfo;
		
		game_ENTITY_INFO entityInfo, hitEntityInfo;
		
		boolean bSyncHitEntity;
		
		game_ENTITY	entity;

		for	( int entityIndex =	0; entityIndex < gameState.activeEntities; entityIndex++ ) {

			entity = gameState.entities[ entityIndex ];

			// if the entity isn't active ignore it...
			// ----------------------------------------------------------------

			if ( 0 != (game_ENTITY_NOT_ACTIVE &	entity.flags) )	{

				continue;

			}
			
			// ----------------------------------------------------------------

			entityInfo = gameState.entityInfoTable[ entity.entity_type ];

#if defined(OLD_ENTITY_TYPE_HISTOGRAM)

			++gameState.entityTypeHistogram[ entityInfo.type ];

#endif // defined(OLD_ENTITY_TYPE_HISTOGRAM)

			// deal	with movement types
			// ----------------------------------------------------------------

			int navigation_type = (entity.movement_type & ENTITY_MOVEMENT_TYPE_MASK);
			
			if ( ENTITY_MOVEMENT_STATIONARY != navigation_type ) {

				// ----------------------------------------------------------------
				
				if ( 0 != (ENTITY_MOVEMENT_USES_INPUT_STREAM_BIT & entity.movement_type) ) {
				
					int inputStreamIndex = (entity.movement_type & ENTITY_MOVEMENT_INPUT_STREAM_MASK);
					
					ProcessEntityMovementCmd( entity, gameState.inputStreams[ inputStreamIndex ] );
					
				}
				
				// ----------------------------------------------------------------
				
				int	tx = entity.x +	entity.delta_x;
				int	ty = entity.y +	entity.delta_y;

				short mx = (short)(tx /	GAME_TILE_PIXELS_CX);
				short my = (short)(ty /	GAME_TILE_PIXELS_CY);

				// ------------------------------------------------------------
				// could inline	entity movement	check..
				// ------------------------------------------------------------

				if ( ((0 <=	tx)	&& (0 <= ty)) && CanEntityMoveToLocation(
					entity
					,mx
					,my
				) )	{

					// adjust pixel	& map position to reflect new position
					// ------------------------------------------------------------

					entity.x = (short)tx;
					entity.y = (short)ty;

					entity.map_x = mx;
					entity.map_y = my;

					// test	distance from the way point	if within bounds choose
					// --------------------------------------------------------

					int	dirFlags;

					if ( (entity.x == entity.way_x)	&& (entity.y ==	entity.way_y) )	{

#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

						// if the entity just moved to it's way point then perform the class value check

						if ( (0 != entity.delta_x) || (0 != entity.delta_y) ) {
						
							currentTileInfo = 
								gameState.tileInfoTable[
									gameState.map[ (entity.map_y * gameState.active_w) + entity.map_x ]
								];
								
							// ------------------------------------------------
							// peform the simple automatic tests
							// ------------------------------------------------
							
							if ( 0 != (GAME_TILE_INFO_SET_PENDING_TILE_ACTION & currentTileInfo.flags) ) {
							
								entity.flags |=	game_ENTITY_CURRENT_TILE_PENDING_ACTION;
								
							}						

							// ------------------------------------------------

							boolean bPerformClassValueTests = 
								(CLASS_VALUE_TEST_TYPE_NONE != currentTileInfo.class_value_test_type)
							&&	(CLASS_VALUE_TEST_SPECIAL_INDICATOR > currentTileInfo.class_value_test_type);

							if ( bPerformClassValueTests ) {

								bPerformClassValueTests = 
									(0 != (entityInfo.class_bits & currentTileInfo.class_value_gateway_bits));

							}

							// ------------------------------------------------

							if ( bPerformClassValueTests ) {

								// ------------------------------------------------

								boolean bTestResults = false;

								switch ( currentTileInfo.class_value_test_type ) {

								case CLASS_VALUE_TEST_TYPE_EXACT:
									bTestResults = (
										entityInfo.class_bits == (entityInfo.class_bits & currentTileInfo.class_value_test_bits)
									);
									break;

								case CLASS_VALUE_TEST_TYPE_ANY:
									bTestResults = (
										0 != (entityInfo.class_bits & currentTileInfo.class_value_test_bits)
									);
									break;

								}

								// ------------------------------------------------
								
								int originalClassValue = entity.class_value;

								short createEntityType = -1;

								if ( bTestResults ) {

									entity.class_value += currentTileInfo.on_class_true_add;
									entity.class_value *= currentTileInfo.on_class_true_multiplier;
									createEntityType = currentTileInfo.on_class_true_create_entity;

									if ( 0 != (GAME_TILE_INFO_ACTION_ON_CLASS_VALUE_TRUE & currentTileInfo.flags) ) {

										entity.flags |= game_ENTITY_CURRENT_TILE_PENDING_ACTION;

									}

								} else {

									entity.class_value += currentTileInfo.on_class_false_add;
									entity.class_value *= currentTileInfo.on_class_false_multiplier;
									createEntityType = currentTileInfo.on_class_false_create_entity;
									
#if 1 // specific to the food chain game?

									FOODCHAIN_ResetFoodTilesForEntity( entity, entityInfo );
									
#endif

								}

								// --------------------------------------------

								if ( entity.class_value > entityInfo.class_value_max ) {

									entity.class_value = entityInfo.class_value_max;

								} else if ( entity.class_value < entityInfo.class_value_min ) {

									entity.class_value = entityInfo.class_value_min;

								}

								// --------------------------------------------

								if ( 0 != (GAME_TILE_INFO_CREATE_ENTITIES_ONLY_ON_VALUE_CHANGE & currentTileInfo.flags) ) {

									if ( originalClassValue == entity.class_value ) {

										createEntityType = -1;

									}

								}

								// --------------------------------------------
								
								if ( -1 != createEntityType ) {
								
									CreateEntityTypeAt(
										createEntityType
										,entity.map_x
										,entity.map_y
										,true
										,entity.class_value
									);
									
								}

							}
						}
						
#endif // class value added (8/31/03)

						// process any pending events (performed on center)
						// ----------------------------------------------------
						
						if ( 0 != (game_ENTITY_ANY_PENDING_TILE_ACTION & entity.flags) )	{

							entity.flags &=	~game_ENTITY_ANY_PENDING_TILE_ACTION;

							PerformActionOnBoardPiece( entity.map_x, entity.map_y );

						}

						// ----------------------------------------------------
						// what	are the current movement options

						int	possibleDirectionFlags =
							gameState.tileInfoTable[
								gameState.map[ (entity.map_y * gameState.active_w) + entity.map_x ]
							].flags;

						// ----------------------------------------------------
						
						if ( ENTITY_MOVEMENT_RANDOM_PATHS == navigation_type )	{

							// ----------------------------------------------------
							// handle (new) 'random paths' entity movement style
							// ----------------------------------------------------

							// what	direction is the entity	going right	now

							dirFlags = CurrentDirectionFromDelta( entity.delta_x, entity.delta_y );
							
							// handle movement

							boolean	bEntityBounced = (0	!= (game_ENTITY_BOUNCED	& entity.flags));

							// possible	enhancment would be	to only	navigate termanal nodes
							// only	if there isn't a open node available.

							if ( (0	== (possibleDirectionFlags & dirFlags))	// if can't	move same direction
								|| bEntityBounced // just bounced
								|| (0 != (game_ENTITY_CHANGE_DIRECTION & entity.flags))	// forced change
								|| (0 == (EntityRandNumber(	entity ) & 15)) ) { // x% just time to choose

								int	rndChoice =	dirFlags;

								entity.flags &=	~game_ENTITY_CHANGE_DIRECTION;
								
								// ********************************************
								// ********************************************

								// build a list of possible directions
								// --------------------------------------------
								
								possibleChoices = 0;

								// --------------------------------------------

								if ( 0 != (GAME_TILE_INFO_U_OUT_CONNECT & possibleDirectionFlags) ) {

									addCount = 1;

									if ( GAME_TILE_INFO_U_OUT_CONNECT == dirFlags ) ++addCount;

									if ( (dirFlags == ((GAME_TILE_INFO_L_OUT_CONNECT|GAME_TILE_INFO_R_OUT_CONNECT) & dirFlags)) ) {

										addCount += 4;

										if ( bEntityBounced ) ++addCount;

									}

									if ( CanEntityMoveToLocation( entity, entity.map_x, (short)(entity.map_y - 1) ) ) {

										++addCount;

									}

									while ( 0 <= --addCount ) {

										s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_U_OUT_CONNECT;

									}

								}

								// --------------------------------------------

								if ( 0 != (GAME_TILE_INFO_R_OUT_CONNECT & possibleDirectionFlags) ) {

									addCount = 1;

									if ( GAME_TILE_INFO_R_OUT_CONNECT == dirFlags ) ++addCount;

									if ( (dirFlags == ((GAME_TILE_INFO_U_OUT_CONNECT|GAME_TILE_INFO_D_OUT_CONNECT) & dirFlags)) ) {

										addCount += 4;

										if ( bEntityBounced ) ++addCount;

									}

									if ( CanEntityMoveToLocation( entity,(short)(entity.map_x + 1), entity.map_y ) ) {

										++addCount;

									}

									while ( 0 <= --addCount ) {

										s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_R_OUT_CONNECT;

									}

								}

								// --------------------------------------------

								if ( 0 != (GAME_TILE_INFO_D_OUT_CONNECT & possibleDirectionFlags) ) {

									addCount = 1;

									if ( GAME_TILE_INFO_D_OUT_CONNECT == dirFlags ) ++addCount;

									if ( (dirFlags == ((GAME_TILE_INFO_L_OUT_CONNECT|GAME_TILE_INFO_R_OUT_CONNECT) & dirFlags)) ) {

										addCount += 4;

										if ( bEntityBounced ) ++addCount;

									}

									if ( CanEntityMoveToLocation( entity, entity.map_x, (short)(entity.map_y + 1) ) ) {

										++addCount;

									}

									while ( 0 <= --addCount ) {

										s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_D_OUT_CONNECT;

									}

								}

								// --------------------------------------------

								if ( 0 != (GAME_TILE_INFO_L_OUT_CONNECT & possibleDirectionFlags) ) {

									addCount = 1;

									if ( GAME_TILE_INFO_L_OUT_CONNECT == dirFlags ) ++addCount;

									if ( (dirFlags == ((GAME_TILE_INFO_U_OUT_CONNECT|GAME_TILE_INFO_D_OUT_CONNECT) & dirFlags)) ) {

										addCount += 4;

										if ( bEntityBounced ) ++addCount;

									}

									if ( CanEntityMoveToLocation( entity, (short)(entity.map_x - 1), entity.map_y ) ) {

										++addCount;

									}

									while ( 0 <= --addCount ) {

										s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_L_OUT_CONNECT;

									}

								}

								// --------------------------------------------

								if ( 0 < possibleChoices ) {

#if 0
									for ( i = possibleChoices>>2; 0 <= i--; ) {

										int a = EntityRandNumber( pEntity ) % possibleChoices;
										int b = EntityRandNumber( pEntity ) % possibleChoices;

										if ( a != b ) {

											int t = directionChoices[ a ];

											s_directionChoices[ a ] = s_directionChoices[ b ];

											s_directionChoices[ b ] = t;

										}

									}
#endif

									dirFlags = (s_directionChoices[
										(EntityRandNumber( entity ) % possibleChoices)
									] & possibleDirectionFlags);

								}
								
								// ********************************************
								// ********************************************

							}
							
#if defined(POLICY_IMPLEMENT_CONNECTED_PATHS_MOVEMENT)
						} else if ( ENTITY_MOVEMENT_ONLY_CONNECTED_PATHS == navigation_type ) {
						
							// ------------------------------------------------
							// only completed paths 
							// ------------------------------------------------

							// what	direction is the entity	going right	now

							dirFlags = CurrentDirectionFromDelta( entity.delta_x, entity.delta_y );
							
							possibleChoices = 0;					
						
							entity.flags &=	~game_ENTITY_CHANGE_DIRECTION;
								
							// --------------------------------------------

							if ( 0 != (GAME_TILE_INFO_U_OUT_CONNECT & possibleDirectionFlags) ) {

								if ( CanEntityMoveToLocation( entity, entity.map_x, (short)(entity.map_y - 1) ) ) {

									s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_U_OUT_CONNECT;

								} else {
								
									possibleDirectionFlags &= ~GAME_TILE_INFO_U_OUT_CONNECT;
								
								}

							}

							// --------------------------------------------

							if ( 0 != (GAME_TILE_INFO_R_OUT_CONNECT & possibleDirectionFlags) ) {

								if ( CanEntityMoveToLocation( entity,(short)(entity.map_x + 1), entity.map_y ) ) {

									s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_R_OUT_CONNECT;

								} else {
								
									possibleDirectionFlags &= ~GAME_TILE_INFO_R_OUT_CONNECT;
								
								}

							}

							// --------------------------------------------

							if ( 0 != (GAME_TILE_INFO_D_OUT_CONNECT & possibleDirectionFlags) ) {

								if ( CanEntityMoveToLocation( entity, entity.map_x, (short)(entity.map_y + 1) ) ) {
								
									s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_D_OUT_CONNECT;

								} else {
								
									possibleDirectionFlags &= ~GAME_TILE_INFO_D_OUT_CONNECT;
								
								}

							}

							// --------------------------------------------

							if ( 0 != (GAME_TILE_INFO_L_OUT_CONNECT & possibleDirectionFlags) ) {

								if ( CanEntityMoveToLocation( entity, (short)(entity.map_x - 1), entity.map_y ) ) {

									s_directionChoices[ possibleChoices++ ] = GAME_TILE_INFO_L_OUT_CONNECT;

								} else {
								
									possibleDirectionFlags &= ~GAME_TILE_INFO_L_OUT_CONNECT;
								
								}

							}
								
							// --------------------------------------------

							if ( 2 == possibleChoices ) {
							
								// --------------------------------------------
								
								int oppositeDir = 0;
								
								switch ( dirFlags ) {
								
								case GAME_TILE_INFO_L_OUT_CONNECT:
									oppositeDir = GAME_TILE_INFO_R_OUT_CONNECT;
									break;
								
								case GAME_TILE_INFO_R_OUT_CONNECT:
									oppositeDir = GAME_TILE_INFO_L_OUT_CONNECT;
									break;
								
								case GAME_TILE_INFO_U_OUT_CONNECT:
									oppositeDir = GAME_TILE_INFO_D_OUT_CONNECT;
									break;
								
								case GAME_TILE_INFO_D_OUT_CONNECT:
									oppositeDir = GAME_TILE_INFO_U_OUT_CONNECT;
									break;
								
								}
								
								// --------------------------------------------
								
								if ( oppositeDir != (possibleDirectionFlags & (~dirFlags)) ) {
								
									if ( oppositeDir == s_directionChoices[ 0 ] ) {
									
										dirFlags = s_directionChoices[ 1 ];
									
									} else {
									
										dirFlags = s_directionChoices[ 0 ];
										
									}
								
								}
							
								dirFlags &= possibleDirectionFlags;
								
							} else if ( 0 < possibleChoices ) {
							
								if ( 0 == (possibleDirectionFlags & dirFlags) ) {
								
									// if not moving choose randomly
									// if can't move same direction reverse
							
									switch ( dirFlags ) {
									
									default:
										dirFlags = s_directionChoices[
											(EntityRandNumber( entity ) % possibleChoices)
										];
										break;
									
									case GAME_TILE_INFO_L_OUT_CONNECT:
										dirFlags = GAME_TILE_INFO_R_OUT_CONNECT;
										break;
									
									case GAME_TILE_INFO_R_OUT_CONNECT:
										dirFlags = GAME_TILE_INFO_L_OUT_CONNECT;
										break;
									
									case GAME_TILE_INFO_U_OUT_CONNECT:
										dirFlags = GAME_TILE_INFO_D_OUT_CONNECT;
										break;
									
									case GAME_TILE_INFO_D_OUT_CONNECT:
										dirFlags = GAME_TILE_INFO_U_OUT_CONNECT;
										break;
									
									}
									
								}
							
								dirFlags &= possibleDirectionFlags;
								
							} else {
							
								dirFlags = 0;
							
							}
							
							// ------------------------------------------------
							// ------------------------------------------------
							
#endif // defined(POLICY_IMPLEMENT_CONNECTED_PATHS_MOVEMENT)
							
#if defined(POLICY_IMPLEMENT_ORGINAL_RANDOM_PATHS_MOVEMENT_TYPE)

						} else if ( ENTITY_MOVEMENT_ORIGINAL_RANDOM_PATHS == navigation_type )	{
						
							// ----------------------------------------------------
							// handle original 'random paths' entity movement style
							// ----------------------------------------------------

							// what	direction is the entity	going right	now

							dirFlags = CurrentDirectionFromDelta( entity.delta_x, entity.delta_y );

							// handle movement

							boolean	bEntityBounced = (0	!= (game_ENTITY_BOUNCED	& entity.flags));

							// possible	enhancment would be	to only	navigate termanal nodes
							// only	if there isn't a open node available.

							if ( (0	== (possibleDirectionFlags & dirFlags))	// if can't	move same direction
								|| bEntityBounced // just bounced
								|| (0 != (game_ENTITY_CHANGE_DIRECTION & entity.flags))	// forced change
								|| (0 == (EntityRandNumber(	entity ) & 3)) ) { // x% just time to choose

								int	rndChoice =	dirFlags;

								entity.flags &=	~game_ENTITY_CHANGE_DIRECTION;

								for	( int i	= 0; i < 4;	i++	) {

									switch ( dirFlags )	{

										case GAME_TILE_INFO_D_OUT_CONNECT:
										case GAME_TILE_INFO_U_OUT_CONNECT:
											if ( 0 != (EntityRandNumber( entity	) &	1) ) {
												if ( (0	!= (GAME_TILE_INFO_L_OUT_CONNECT & possibleDirectionFlags))
												&& (0 != (EntityRandNumber(	entity ) & 1)) ) {
													rndChoice =	GAME_TILE_INFO_L_OUT_CONNECT;
													break;
												}
												if ( 0 != (GAME_TILE_INFO_R_OUT_CONNECT	& possibleDirectionFlags) )	{
													rndChoice =	GAME_TILE_INFO_R_OUT_CONNECT;
													break;
												}
											}
											break;

										case GAME_TILE_INFO_R_OUT_CONNECT:
										case GAME_TILE_INFO_L_OUT_CONNECT:
											if ( 0 != (EntityRandNumber( entity	) &	1) ) {
												if ( (0	!= (GAME_TILE_INFO_U_OUT_CONNECT & possibleDirectionFlags))
												&& (0 != (EntityRandNumber(	entity ) & 1)) ) {
													rndChoice =	GAME_TILE_INFO_U_OUT_CONNECT;
													break;
												}
												if ( 0 != (GAME_TILE_INFO_D_OUT_CONNECT	& possibleDirectionFlags) )	{
													rndChoice =	GAME_TILE_INFO_D_OUT_CONNECT;
													break;
												}
											}
											break;

									}

									if ( 0 == (possibleDirectionFlags &	rndChoice) ) {

										rndChoice =	1 << (i	+ 0); // base);

										if ( (rndChoice	!= dirFlags) &&	(0 != (possibleDirectionFlags &	rndChoice))	) {

											break;

										}

									}

								}

								dirFlags = (rndChoice & possibleDirectionFlags);

							}
							
#endif
						
						} else {

							// ----------------------------------------------------
							// pending movement type
							// ----------------------------------------------------

							// stop

							entity.delta_x = 0;

							entity.delta_y = 0;

#if 0

							// what	are the current movement	options

							int	possibleDirectionFlags =
								gameState.tileInfoTable[
									gameState.map[ (entity.map_y * gameState.active_w) + entity.map_x ]
								].flags;
								
#endif

							// process pending direction change

							dirFlags = (entity.pendingDirection	& possibleDirectionFlags);

							entity.pendingDirection	= 0;

						}

						// handle directional movement request
						// --------------------------------------------------------

						if ( 0 != dirFlags ) {

							switch ( dirFlags )	{

								case GAME_TILE_INFO_D_OUT_CONNECT:
									entity.way_y +=	GAME_TILE_PIXELS_CY;
									break;

								case GAME_TILE_INFO_R_OUT_CONNECT:
									entity.way_x +=	GAME_TILE_PIXELS_CX;
									break;

								case GAME_TILE_INFO_L_OUT_CONNECT:
									entity.way_x -=	GAME_TILE_PIXELS_CX;
									break;

								case GAME_TILE_INFO_U_OUT_CONNECT:
									entity.way_y -=	GAME_TILE_PIXELS_CY;
									break;

							}

							// <<FUTURE>>
							// ENTITY POSITION SHOULD USE A	FIXED POINT	REPRESENTATION TO ALLOW	FOR
							// BETTER MOVEMENT CONTROL ESPECIALLY ON LOW RESOLUTION	DEVICES	THAT
							// HAVE	HIGH FRAME RATES (DOES THAT	HAPPEN?)
							// <<FUTURE>>

							// okay	now	calculate the per frame	step
							// ----------------------------------------------------

							// calculate the number	of frames that the movement	should last

							tx = (entityInfo.entity_speed *	gameState.framesPerSecond) >> 8;

							// finally calculate the per frame delta
							
							if ( 0 != tx ) {

								entity.delta_x = (short)((entity.way_x - entity.x) / tx);
								entity.delta_y = (short)((entity.way_y - entity.y) / tx);
								
							} else {
							
								entity.delta_x = (short)((entity.way_x - entity.x));
								entity.delta_y = (short)((entity.way_y - entity.y));
								
							}

							// clear our bounced flag
							// ----------------------------------------------------

							entity.flags &=	~game_ENTITY_BOUNCED;

						} else {
						
							entity.delta_x = 0;
							entity.delta_y = 0;
							
						}

					}

				} else {

					// go back to the center

					entity.way_x = (short)((entity.map_x * GAME_TILE_PIXELS_CX)	+ (GAME_TILE_PIXELS_CX/2));
					entity.way_y = (short)((entity.map_y * GAME_TILE_PIXELS_CY)	+ (GAME_TILE_PIXELS_CY/2));

					entity.delta_x = (short)-entity.delta_x;
					entity.delta_y = (short)-entity.delta_y;

					entity.flags |=	game_ENTITY_BOUNCED;

				}

			} // moving	type
			
#if defined(SEPERATED_COLLSION_DETECTION_LOGIC)

		}

		// ********************************************************************
		// Collision detection
		// ********************************************************************
		
		for	( int entityIndex =	0; entityIndex < gameState.activeEntities; entityIndex++ ) {

			game_ENTITY	entity = gameState.entities[ entityIndex ];

			// if the entity isn't active ignore it...
			// ----------------------------------------------------------------

			if ( 0 != (game_ENTITY_NOT_ACTIVE &	entity.flags) )	{

				continue;

			}
			
			// ----------------------------------------------------------------

			game_ENTITY_INFO entityInfo	= gameState.entityInfoTable[ entity.entity_type	];

#endif // defined(SEPERATED_COLLSION_DETECTION_LOGIC)

// ============================================================================
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

#if 0 // to be removed block

// eventually remove this code!
// eventually remove this code!

			// ================================================================
			// Perform entity affecting actions that the tile requests
			// ================================================================

			int currentTileFlags = gameState.tileInfoTable[
				gameState.map[ (entity.map_y * gameState.active_w) + entity.map_x ]
			].flags;
			
			if ( 0 != (GAME_TILE_INFO_SET_PENDING_TILE_ACTION & currentTileFlags) ) {
			
				entity.flags |=	game_ENTITY_CURRENT_TILE_PENDING_ACTION;
				
			} else {
			
				entity.flags &=	~game_ENTITY_CURRENT_TILE_PENDING_ACTION;
				
			}
			
#endif // to be removed block

// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
// ============================================================================

			// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			// OTHER TILE ACTIONS HERE (HEALTH, MOVEMENT, ETC)
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

			// manage the health of	the	entity
			// ----------------------------------------------------------------

			entity.health += entityInfo.healing_rate;

			if ( entity.health > entityInfo.max_health ) {

				entity.health =	entityInfo.max_health;

			}

			// ----------------------------------------------------------------

			if ( 0 >= entity.health	) {

				entity.health =	0;
				
#if 0				
				if ( 0 == entityIndex )	{

					gameState.status |=	GAME_STATE_SF_PLAYER_DEAD;

				}
#endif

			}

			// check to	see	if the entity has collided with	the	player
			// ----------------------------------------------------------------

			for ( int ce = 0; ce < gameState.collectorEntityCount; ce++ ) {

				int hitCheckIndex = gameState.entitiesThatCanCollectThings[ ce ];
				
				if ( entityIndex == hitCheckIndex ) continue;
				
				game_ENTITY hitCheckEntity = gameState.entities[ hitCheckIndex ];
				
				if ( 0 != (game_ENTITY_NOT_ACTIVE &	hitCheckEntity.flags) )	{

					continue;

				}
				
				// ------------------------------------------------------------

				int	tx = (entity.x - hitCheckEntity.x);

				if ( 0 > tx	) tx = -tx;

				int	ty = (entity.y - hitCheckEntity.y);

				if ( 0 > ty	) ty = -ty;

				if ( (gameState.entityCollisionDistance >= tx) && 
					(gameState.entityCollisionDistance >= ty) )	{

					// --------------------------------------------------------
					
					hitEntityInfo = gameState.entityInfoTable[ hitCheckEntity.entity_type ];

#if 0 // COLLISION_FIX BPT 9/23/03
					entity.flags |=	game_ENTITY_COLLIDED;
#endif // COLLISION_FIX BPT 9/23/03

					bSyncHitEntity = false;

					// --------------------------------------------------------

					if ( 0 != (ENTITY_INFO_FLAG_SET_COLLECTION_BIT_ON_HIT & entityInfo.flags) ) {
					
						hitCheckEntity.flags |= game_ENTITY_PICKED_UP;
						
						bSyncHitEntity = true;
					
					}
						
					// handle health transfers
					// --------------------------------------------------------

					if ( (GAME_ENTITY_INFO_TYPE_PLAYER == hitEntityInfo.type)
						|| (0 != (ENTITY_INFO_FLAG_MUTUAL_HEALTH_TRANSFER & hitEntityInfo.flags))
						) {
					
						hitCheckEntity.health -= entityInfo.hit_the_player_damage;

						if ( 0 >= hitCheckEntity.health )	{

							hitCheckEntity.health = 0;

							hitCheckEntity.flags |= game_ENTITY_DEAD;
							
#if 0							
							gameState.status |=	GAME_STATE_SF_PLAYER_DEAD;
#endif

							bSyncHitEntity = true;
						
						}
						
					}
					
					if ( bSyncHitEntity ) {
					
						SyncEntityToCurrentState( hitCheckEntity );
						
					}

					// deal	with the response (only once)
					// --------------------------------------------------------

					entity.health -= entityInfo.hit_by_player_damage;

					switch ( entityInfo.type ) {

						case GAME_ENTITY_INFO_TYPE_MOVING_PRIZE:
						case GAME_ENTITY_INFO_TYPE_STATIC_PRIZE:
						case GAME_ENTITY_INFO_TYPE_EOL_PRIZE:
						case GAME_ENTITY_INFO_TYPE_GOAL:  // COLLISION_FIX BPT 9/23/03
							// response	animation!
							// Need	to collect the prize
							entity.flags |=	game_ENTITY_PICKED_UP;
							break;

					}
				
					if ( 0 != (game_ENTITY_NOT_ACTIVE &	entity.flags) )	{ // only collect once...

						break;

					}

				}

			}

			// ----------------------------------------------------------------

			if ( 0 >= entity.health	) {

				entity.flags |=	game_ENTITY_DEAD;

				entity.health =	0;

#if 0
				if ( 0 == entityIndex )	{

					gameState.status |=	GAME_STATE_SF_PLAYER_DEAD;

				}
#endif

			}

			// Sync	the	animation
			// ----------------------------------------------------------------

			SyncEntityToCurrentState( entity );

		}

		// --------------------------------------------------------------------

#if !defined(OLD_ENTITY_TYPE_HISTOGRAM)

		// empty out the stats for the entity types
		// --------------------------------------------------------------------
		
		int len = gameState.entityTypeHistogram.length;

		for	( int i	= len; 0 <= --i; ) {

			gameState.entityTypeHistogram[ i ] = 0;

		}
		
		// Figure out the exact state of the entity types
		// --------------------------------------------------------------------

		for ( int entityCounter = gameState.activeEntities; 0 <= --entityCounter; ) {
		
			entity = gameState.entities[ entityCounter ];
			
			if ( 0 != (game_ENTITY_NOT_ACTIVE & entity.flags) ) continue;

			++gameState.entityTypeHistogram[ gameState.entityInfoTable[ entity.entity_type ].type ];

		}

#endif // !defined(OLD_ENTITY_TYPE_HISTOGRAM)

	}

	// ----------------------------------------------------------------------------
	// render playfield
	// ----------------------------------------------------------------------------
	
	//
	//	CalculateTileClippingRectangles()
	//
	
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

	INTERNAL_METHOD( int )
	CalculateTileClippingRectangles(
		game_TILE_INFO tileInfo
		,int mapIndex
		,int mapFlags
		,int _left
		,int _top
		,boolean bOnlyInternalRects
		) {
	
// NOTE: There is overdraw potential in this code! (the corners could be combined the others if they overlap...)
		
		// --------------------------------------------------------------------
		
		int index = 0;
		
		// --------------------------------------------------------------------
	
		int internalRectangle_left = _left;
		
		int internalRectangle_top = _top;
		
		int internalRectangle_right = _left + GAME_TILE_PIXELS_CX;
		
		int internalRectangle_bottom = _top + GAME_TILE_PIXELS_CY;
		
		// --------------------------------------------------------------------
		
		int full_rect_left = internalRectangle_left;
		
		int full_rect_top = internalRectangle_top;
		
		int full_rect_right = internalRectangle_right;
		
		int full_rect_bottom = internalRectangle_bottom;
		
		if ( !bOnlyInternalRects ) {
		
			if ( 0 != (MAP_FLAG_TILE_REDRAW_LEFT & mapFlags) ) full_rect_left -= tileInfo.left_reach;

			if ( 0 != (MAP_FLAG_TILE_REDRAW_TOP & mapFlags) ) full_rect_top -= tileInfo.top_reach;

			if ( 0 != (MAP_FLAG_TILE_REDRAW_RIGHT & mapFlags) ) full_rect_right += tileInfo.right_reach;
			
			if ( 0 != (MAP_FLAG_TILE_REDRAW_BOTTOM & mapFlags) ) full_rect_bottom += tileInfo.bottom_reach;
			
		}
		
		// --------------------------------------------------------------------
		
		if ( 0 != (MAP_FLAG_TILE_REDRAW_ANY_CORNER & mapFlags) ) {
		
			if ( 0 != (MAP_FLAG_TILE_REDRAW_TOP_LEFT_CORNER & mapFlags) ) {
			
				gameState.clippingRectangles[ index ].left = full_rect_left;
				gameState.clippingRectangles[ index ].top = full_rect_top;
				gameState.clippingRectangles[ index ].right = internalRectangle_left + gameState.map_tile_right_reach[ mapIndex - gameState.active_w - 1 ];
				gameState.clippingRectangles[ index ].bottom = internalRectangle_top + gameState.map_tile_bottom_reach[ mapIndex - gameState.active_w - 1 ];
				
				++index;
				
			}
			
			if ( 0 != (MAP_FLAG_TILE_REDRAW_TOP_RIGHT_CORNER & mapFlags) ) {
			
				gameState.clippingRectangles[ index ].left = internalRectangle_right - gameState.map_tile_right_reach[ mapIndex - gameState.active_w + 1 ];
				gameState.clippingRectangles[ index ].top = full_rect_top;
				gameState.clippingRectangles[ index ].right = full_rect_right;
				gameState.clippingRectangles[ index ].bottom = internalRectangle_top + gameState.map_tile_bottom_reach[ mapIndex - gameState.active_w + 1 ];
				
				++index;
			}
			
			if ( 0 != (MAP_FLAG_TILE_REDRAW_BOTTOM_RIGHT_CORNER & mapFlags) ) {
			
				gameState.clippingRectangles[ index ].left = internalRectangle_right - gameState.map_tile_left_reach[ mapIndex + gameState.active_w + 1 ];
				gameState.clippingRectangles[ index ].top = internalRectangle_bottom - gameState.map_tile_top_reach[ mapIndex + gameState.active_w + 1 ];
				gameState.clippingRectangles[ index ].right = full_rect_right;
				gameState.clippingRectangles[ index ].bottom = full_rect_bottom;
				
				++index;
			}
			
			if ( 0 != (MAP_FLAG_TILE_REDRAW_BOTTOM_LEFT_CORNER & mapFlags) ) {
			
				gameState.clippingRectangles[ index ].left = full_rect_left;
				gameState.clippingRectangles[ index ].top = internalRectangle_bottom - gameState.map_tile_right_reach[ mapIndex + gameState.active_w - 1 ];
				gameState.clippingRectangles[ index ].right = internalRectangle_left + gameState.map_tile_top_reach[ mapIndex + gameState.active_w - 1 ];
				gameState.clippingRectangles[ index ].bottom = full_rect_bottom;
				
				++index;
			}
			
		}
		
		// --------------------------------------------------------------------
	
		if ( 0 != (MAP_FLAG_TILE_REDRAW_LEFT & mapFlags) ) {
		
			internalRectangle_left += gameState.map_tile_right_reach[ mapIndex - 1 ];
		
		}

		if ( 0 != (MAP_FLAG_TILE_REDRAW_TOP & mapFlags) ) {
		
			internalRectangle_top += gameState.map_tile_bottom_reach[ mapIndex - gameState.active_w ];
			
		}

		if ( 0 != (MAP_FLAG_TILE_REDRAW_RIGHT & mapFlags) ) {
		
			internalRectangle_right -= gameState.map_tile_left_reach[ mapIndex + 1 ];
			
		}

		if ( 0 != (MAP_FLAG_TILE_REDRAW_BOTTOM & mapFlags) ) {
		
			internalRectangle_bottom -= gameState.map_tile_top_reach[ mapIndex + gameState.active_w ];
			
		}

		// top line
		// --------------------------------------------------------------------

		int y1;

		if ( full_rect_top < internalRectangle_top ) {

			gameState.clippingRectangles[ index ].left = full_rect_left;
			gameState.clippingRectangles[ index ].top = full_rect_top;
			gameState.clippingRectangles[ index ].right = full_rect_right;
			gameState.clippingRectangles[ index ].bottom = internalRectangle_top;

			y1 = internalRectangle_top;
			
			++index;

		} else {

			y1 = full_rect_top;

		}

		// bottom line
		// --------------------------------------------------------------------

		int y2;

		if ( full_rect_bottom > internalRectangle_bottom ) {

			gameState.clippingRectangles[ index ].left = full_rect_left;
			gameState.clippingRectangles[ index ].top = internalRectangle_bottom;
			gameState.clippingRectangles[ index ].right = full_rect_right;
			gameState.clippingRectangles[ index ].bottom = full_rect_bottom;

			y2 = internalRectangle_bottom;

			++index;
			
		} else {

			y2 = full_rect_bottom;

		}

		// Left?
		// --------------------------------------------------------------------

		if ( full_rect_left < internalRectangle_left ) {

			gameState.clippingRectangles[ index ].left = full_rect_left;
			gameState.clippingRectangles[ index ].top = y1;
			gameState.clippingRectangles[ index ].right = internalRectangle_left;
			gameState.clippingRectangles[ index ].bottom = y2;

			++index;
			
		}

		// Right?
		// --------------------------------------------------------------------

		if ( full_rect_right > internalRectangle_right ) {

			gameState.clippingRectangles[ index ].left = internalRectangle_right;
			gameState.clippingRectangles[ index ].top = y1;
			gameState.clippingRectangles[ index ].right = full_rect_right;
			gameState.clippingRectangles[ index ].bottom = y2;

			++index;
			
		}
		
		return index;
		
	}
	
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

	//
	//	GAME_RenderPlayfield()
	//

	INTERNAL_METHOD( void )
	GAME_RenderPlayfield() {
	
// needs to indicate this rendering is in the background...
// needs to indicate this rendering is in the background...
					
		
/*
	
	NOTE	-- this code is most likely too slow for scrolling worlds!
			-- there is no need to call the renderer for items that you know
			-- are clipped outside the viewing rectangle...

*/		

		try {

			// Render the playfield background (manage snap scroll as well)
			// ----------------------------------------------------------------

#if defined(SCROLLING_TILE_MAP_SUPPORT)

			int view_x = gameState.map_view_pixel_x;
			int view_y = gameState.map_view_pixel_y;

			view_x -= (view_x % GAME_TILE_PIXELS_CX);
			view_y -= (view_y % GAME_TILE_PIXELS_CY);
			
#endif // defined(SCROLLING_TILE_MAP_SUPPORT)

			// ----------------------------------------------------------------

#if 1

#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			if ( gameState.bEntireBackgroundChanged ) {
			
				currentAnimEngine.ClearBackground();
				
				gameState.bEntireBackgroundChanged = false;
				
			}

#else

			currentAnimEngine.ClearBackground();

#endif // !defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)
			
#else
			
			if ( 0 != gameState.ANIM_STATE_POLICY_ACCESS(backgroundAnimState,animation) ) {

				currentAnimEngine.Render(
					gameState.ANIM_STATE_POLICY_ACCESS(backgroundAnimState,animation)
					,gameState.ANIM_STATE_POLICY_ACCESS(backgroundAnimState,frame)
					,gameState.ANIM_STATE_POLICY_ACCESS(backgroundAnimState,conditions_8)
#if defined(SCROLLING_TILE_MAP_SUPPORT)
					,-view_x
					,-view_y
#else
					,0
					,0
#endif // defined(SCROLLING_TILE_MAP_SUPPORT)
					,true
					,null
				);
				
				// currentAnimEngine.AdvanceAnimationState( gameState.backgroundAnimState );
				
			} else {
			
				currentAnimEngine.ClearBackground();
			
			}
			
#endif

			// ----------------------------------------------------------------
			
//System.out.println( "RenderPlayfield!" );

			game_TILE_INFO tileInfo;
								
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			short mapFlags;
			
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

			int nClippedRects;

			int l_Index, c_Index, r_Index;
			
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
				
			for ( int pass = 4; 0 <= --pass; ) {
			
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)
		
				int mapIndex = 0;
				
				int y = 0;
				
				int x, h;
				
				boolean bOdd;
				
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

				boolean bFirstRow = true;
				
				boolean bLastRow, bFirstCol, bLastCol;
				
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)
				
				for ( int v = gameState.active_h; 0 <= --v; ) {
				
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

					bLastRow = (0 == v);
					
					bFirstCol = true;
					
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
				
					for ( x = 0, h = gameState.active_w; 0 <= --h;
						mapIndex++, x += GAME_TILE_PIXELS_CX
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)
						,bFirstCol = false
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
					) {
					
						bOdd = (0 == ((v + h) & 1));
						
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

						nClippedRects = 0;
						
						bLastCol = (0 == h);
						
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
						
						// ----------------------------------------------------
						
						mapFlags = gameState.map_flags[ mapIndex ];
						
						if ( 0 == mapFlags ) {
						
							continue;
						
						}

						// ----------------------------------------------------
						
						switch ( pass ) {
						
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

						case 3: { /* Mark the neighbor tiles based on reach... */
						
								if ( 0 == (MAP_FLAG_TILE_CHANGED & mapFlags) ) {
								
									break;
									
								}
								
								// --------------------------------------------
								
								if ( !bFirstRow ) {
						
									l_Index = mapIndex - gameState.active_w - 1;
									c_Index = mapIndex - gameState.active_w;
									r_Index = mapIndex - gameState.active_w + 1;
									
									// check the reach of the current tile
									// ----------------------------------------
									
									if ( 0 != gameState.map_tile_top_reach[ mapIndex ] ) {
									
										gameState.map_flags[ c_Index ] |= MAP_FLAG_TILE_REDRAW_BOTTOM;
										
										if ( (0 != gameState.map_tile_left_reach[ mapIndex ]) && (!bFirstCol) ) {
										
											gameState.map_flags[ l_Index ] |= 
												MAP_FLAG_TILE_REDRAW_BOTTOM_RIGHT_CORNER;
											
										}
										
										if ( (0 != gameState.map_tile_right_reach[ mapIndex ]) && (!bLastCol) ) {
										
											gameState.map_flags[ r_Index ] |= 
												MAP_FLAG_TILE_REDRAW_BOTTOM_LEFT_CORNER;
											
										}
										
									}
									
									// check the reach of the neighbor tiles
									// ----------------------------------------
									
									if ( 0 != gameState.map_tile_bottom_reach[ c_Index ] ) {
									
										gameState.map_flags[ c_Index ] |= MAP_FLAG_TILE_REDRAW_BOTTOM;
										
									}
									
									if ( (!bFirstCol)
										&& (0 != gameState.map_tile_bottom_reach[ l_Index ])
										&& (0 != gameState.map_tile_right_reach[ l_Index ])
										) {
									
										gameState.map_flags[ l_Index ] |= MAP_FLAG_TILE_REDRAW_BOTTOM_RIGHT_CORNER;
										
									}

									if ( (!bLastCol)
										&& (0 != gameState.map_tile_bottom_reach[ r_Index ])
										&& (0 != gameState.map_tile_left_reach[ r_Index ])
										) {
									
										gameState.map_flags[ r_Index ] |= MAP_FLAG_TILE_REDRAW_BOTTOM_LEFT_CORNER;
										
									}
									
								}
								
								// --------------------------------------------
								
								if ( (0 != gameState.map_tile_bottom_reach[ mapIndex ]) && (!bLastRow) ) {
									
									l_Index = mapIndex + gameState.active_w - 1;
									c_Index = mapIndex + gameState.active_w;
									r_Index = mapIndex + gameState.active_w + 1;
									
									// check the reach of the current tile
									// ----------------------------------------
									
									gameState.map_flags[ c_Index ] |= MAP_FLAG_TILE_REDRAW_TOP;
									
									if ( (0 != gameState.map_tile_left_reach[ mapIndex ]) && (!bFirstCol) ) {
									
										gameState.map_flags[ l_Index ] |= 
											MAP_FLAG_TILE_REDRAW_TOP_RIGHT_CORNER;
										
									}
									
									if ( (0 != gameState.map_tile_right_reach[ mapIndex ]) && (!bLastCol) ) {
									
										gameState.map_flags[ r_Index ] |=
											MAP_FLAG_TILE_REDRAW_TOP_LEFT_CORNER;
										
									}
								
									// check the reach of the neighbor tiles
									// ----------------------------------------
									
									if ( 0 != gameState.map_tile_top_reach[ c_Index ] ) {
									
										gameState.map_flags[ c_Index ] |= MAP_FLAG_TILE_REDRAW_TOP;
										
									}
									
									if ( (!bFirstCol)
										&& (0 != gameState.map_tile_top_reach[ l_Index ])
										&& (0 != gameState.map_tile_right_reach[ l_Index ])
										) {
									
										gameState.map_flags[ l_Index ] |= MAP_FLAG_TILE_REDRAW_TOP_RIGHT_CORNER;
										
									}

									if ( (!bLastCol)
										&& (0 != gameState.map_tile_top_reach[ r_Index ])
										&& (0 != gameState.map_tile_left_reach[ r_Index ])
										) {
									
										gameState.map_flags[ r_Index ] |= MAP_FLAG_TILE_REDRAW_TOP_LEFT_CORNER;
										
									}
									
								}
								
								// --------------------------------------------
								
								if ( !bFirstCol ) {

									if ( 0 != gameState.map_tile_left_reach[ mapIndex ] ) {
									
										gameState.map_flags[ mapIndex - 1 ] |= MAP_FLAG_TILE_REDRAW_RIGHT;
										
									}
									
									// ----------------------------------------
									
									if ( 0 != gameState.map_tile_right_reach[ mapIndex - 1 ] ) {
									
										gameState.map_flags[ mapIndex - 1 ] |= MAP_FLAG_TILE_REDRAW_RIGHT;
									
									}
									
								}
								
								// --------------------------------------------
								
								if ( !bLastCol ) {

									if ( 0 != gameState.map_tile_right_reach[ mapIndex ] ) {
									
										gameState.map_flags[ mapIndex + 1 ] |= MAP_FLAG_TILE_REDRAW_LEFT;
										
									}
									
									// ----------------------------------------
									
									if ( 0 != gameState.map_tile_left_reach[ mapIndex + 1 ] ) {
									
										gameState.map_flags[ mapIndex + 1 ] |= MAP_FLAG_TILE_REDRAW_LEFT;
									
									}
									
								}
								
							}
							break;
							
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

						// ====================================================
						
						case 2: /* Paint the background (needs a NOP option!)... */
						
							tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];
							
							if ( 0 != (GAME_TILE_INFO_IMAGE_HAS_NO_TRANSPARENCY & tileInfo.flags ) ) {
							
								break;
							
							}
							
							if ( 0 != (MAP_FLAG_TILE_CHANGED & mapFlags) ) {
							 
								currentAnimEngine.RenderBackgroundChecker(
									x
									,y
									,GAME_TILE_PIXELS_CX
									,GAME_TILE_PIXELS_CY
									,bOdd
									,null
								);
								
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)
							} else {
							
								nClippedRects = CalculateTileClippingRectangles( tileInfo, mapIndex, mapFlags, x, y, true );

								for ( int nRect = nClippedRects; 0 <= --nRect; ) {
								
#if 1 // this might be a little faster than using the clipping rect.
								
									currentAnimEngine.RenderBackgroundChecker(
										gameState.clippingRectangles[ nRect ].left
										,gameState.clippingRectangles[ nRect ].top
										,(gameState.clippingRectangles[ nRect ].right - gameState.clippingRectangles[ nRect ].left)
										,(gameState.clippingRectangles[ nRect ].bottom - gameState.clippingRectangles[ nRect ].top)
										,bOdd
										,null
									);
									
#else								
								
									currentAnimEngine.RenderBackgroundChecker(
										x
										,y
										,GAME_TILE_PIXELS_CX
										,GAME_TILE_PIXELS_CY
										,bOdd
										,gameState.clippingRectangles[ nRect ]
									);
									
#endif
									
								}
						
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

							}
							break;
							
						case 1: /* Call the renderer for each clipping area */
						
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

							if ( 0 != (MAP_FLAG_TILE_CHANGED & mapFlags) ) {
							
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
							
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

								tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];
								
								currentAnimEngine.Render(
									tileInfo.ANIM_STATE_POLICY_ACCESS(animState,animation)
									,tileInfo.ANIM_STATE_POLICY_ACCESS(animState,frame)
									,gameState.map_condition_8s[ mapIndex ]
									,x
									,y
									,true
									,null								
								);
							
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

							} else {
							
								tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];
								
								nClippedRects = CalculateTileClippingRectangles( tileInfo, mapIndex, mapFlags, x, y, false );
								
								for ( int nRect = nClippedRects; 0 <= --nRect; ) {
								
									currentAnimEngine.Render(
										tileInfo.ANIM_STATE_POLICY_ACCESS(animState,animation)
										,tileInfo.ANIM_STATE_POLICY_ACCESS(animState,frame)
										,gameState.map_condition_8s[ mapIndex ]
										,x
										,y
										,true
										,gameState.clippingRectangles[ nRect ]										
									);
									
								}
							
							}
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

							break;
							
						case 0: /* final step clear the update and store the tile reach information */
							gameState.map_flags[ mapIndex ] = 0;
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)
							tileInfo = gameState.tileInfoTable[ (gameState.map[ mapIndex ]) ];
							gameState.map_tile_left_reach[ mapIndex ] = tileInfo.left_reach;
							gameState.map_tile_top_reach[ mapIndex ] = tileInfo.top_reach;
							gameState.map_tile_right_reach[ mapIndex ] = tileInfo.right_reach;
							gameState.map_tile_bottom_reach[ mapIndex ] = tileInfo.bottom_reach;
#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)
							break;
							
						}
						
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

						// ----------------------------------------------------
						
					}
					
					y += GAME_TILE_PIXELS_CY;

#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

					bFirstRow = false;
					
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

				}
				
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			}
			
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)
			
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_RENDER_PLAYFIELD );
		
		}

	}

	// ------------------------------------------------------------------------

	//
	//	GAME_SortRenderTable()
	//

	INTERNAL_METHOD( void )
	GAME_SortRenderTable( int nCount ) {
	
		// This uses a COMB sort, since it's easy to implement and compact
		// if the number of entities grows then a better sort should replace
		// this one.
		
		game_ENTITY_SORT_HELPER orderTable[] = gameState.entityRenderOrder;

		int exchangedElementCount;

		int gap = nCount;

		do {

			// manage the gap
			// ----------------------------------------------------------------

			gap = ((gap * 196)) >> 8; // (almost a shrink factor of 1.3)

			switch (gap) {

			case 0:
				gap = 1;
				break;

			case 9:
			case 10:
				gap = 11;
				break;

			}

			// Perform element exchange as necessary
			// ----------------------------------------------------------------

			exchangedElementCount = 0;

			int top = nCount - gap;

			for (int  i = 0; i < top; i++ ) {

				int j = i + gap;

				if ( orderTable[ i ].priority > orderTable[ j ].priority ) {

					game_ENTITY_SORT_HELPER swap = orderTable[ i ];
					orderTable[ i ] = orderTable[ j ];
					orderTable[ j ] = swap;

					++exchangedElementCount;

				}

			}

		} while ( (0 != exchangedElementCount) || (1 < gap) );

	}

	// ------------------------------------------------------------------------

	//
	//	GAME_RenderEntities()
	//

	INTERNAL_METHOD( void )
	GAME_RenderEntities() {
		
		// prepare for sort (could probably cache the results of this sort)
		// --------------------------------------------------------------------
		
#if defined(DBUG_SIMPLE_PROFILER) 
		int pidA = gameState.simpleProfiler.Start( "RA" );
#endif

		int activeCount = 0;
		
		game_ENTITY_INFO entityTypeInfo;

		for ( int i = 0; i < gameState.activeEntities; i++ ) {

			if ( 0 != (game_ENTITY_NOT_ACTIVE & gameState.entities[ i ].flags) ) {
			
				continue; // no need to render (or sort)
				
			}
			
			entityTypeInfo = gameState.entityInfoTable[ gameState.entities[ i ].entity_type ];
			
			if ( 0 != (ENTITY_INFO_FLAG_INVISIBLE_ENTITY_OPTIMIZATION & entityTypeInfo.flags) ) {
			
				continue; // no need to render (or sort)
				
			}

			gameState.entityRenderOrder[ activeCount ].index = (short)i;
			
			gameState.entityRenderOrder[ activeCount ].priority =
				(short)(i +
				(gameState.entities[ i ].y << 8) +
				entityTypeInfo.sort_priority
				)
				;

			++activeCount;

		}
			
		// sort the table
		// --------------------------------------------------------------------
		
		GAME_SortRenderTable( activeCount );

#if defined(DBUG_SIMPLE_PROFILER)
		gameState.simpleProfiler.End( pidA );
#endif

		// finally render them back to front
		// --------------------------------------------------------------------
		
#if defined(DBUG_SIMPLE_PROFILER)
		int pidB = gameState.simpleProfiler.Start( "RB" );
#endif

		try {
		
			// ----------------------------------------------------------------

#if defined(SCROLLING_TILE_MAP_SUPPORT)

			int xOffset = -gameState.map_view_pixel_x;

			int yOffset = -gameState.map_view_pixel_y;

#endif // defined(SCROLLING_TILE_MAP_SUPPORT)

			// ----------------------------------------------------------------

			for ( int i = 0; i < activeCount; i++ ) {

				game_ENTITY entity = gameState.entities[ gameState.entityRenderOrder[ i ].index ];
				
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!				
// could combine the rendering and animation advancement into one function...
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!				

				currentAnimEngine.Render(
					entity.ANIM_STATE_POLICY_ACCESS(animState,animation)
					,entity.ANIM_STATE_POLICY_ACCESS(animState,frame)
					,entity.ANIM_STATE_POLICY_ACCESS(animState,conditions_8)
#if defined(SCROLLING_TILE_MAP_SUPPORT)
					,entity.x + xOffset
					,entity.y + yOffset
#else
					,entity.x
					,entity.y 
#endif // defined(SCROLLING_TILE_MAP_SUPPORT)
					,false
					,null
				);

// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!				
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

				// ------------------------------------------------------------

#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

				int class_value_render_type = gameState.entityInfoTable[ entity.entity_type ].class_value_render_type;

				if ( 0 != class_value_render_type ) {

					int class_value_animation = gameState.entityInfoTable[ entity.entity_type ].class_value_animation;

					if ( 0 != class_value_animation ) {
					
						switch ( class_value_render_type ) {
						
						case 1:
							currentAnimEngine.Render(
								class_value_animation
								,entity.class_value
								,(byte)0
#if defined(SCROLLING_TILE_MAP_SUPPORT)
								,entity.x + xOffset
								,entity.y + yOffset
#else
								,entity.x
								,entity.y
#endif // defined(SCROLLING_TILE_MAP_SUPPORT)
								,false
								,null
							);
							break;
							
						case 2:
							currentAnimEngine.RenderDigitsAnimationNumber(
								class_value_animation
								,entity.class_value
#if defined(SCROLLING_TILE_MAP_SUPPORT)
								,entity.x + xOffset
								,entity.y + yOffset
#else								
								,entity.x
								,entity.y
#endif // defined(SCROLLING_TILE_MAP_SUPPORT)
								,false
								,null
								,true
							);
							break;
						
						}

					}

				}

#endif // class value added (8/31/03)

				// ------------------------------------------------------------------------
				
				if (
					(0 == (game_ENTITY_USING_ROOT_ANIMATION & entity.flags)) ? true :
					(0 == (ENTITY_MOVEMENT_STATIC_ROOT_ANIMATIONS & 
						gameState.entityInfoTable[ entity.entity_type ].default_movement_type))
					) {
					
#if defined(USE_ANIM_STATE_CLASS)

					if ( currentAnimEngine.AdvanceAnimationState( entity.animState ) ) {
					
#else

					if ( ++entity.ANIM_STATE_POLICY_ACCESS(animState,frame) > 
						entity.ANIM_STATE_POLICY_ACCESS(animState,last_frame) ) {
						
						entity.ANIM_STATE_POLICY_ACCESS(animState,frame) = 0;
						
#endif

						// check type to see if it's now dead...
						
						int type = gameState.entityInfoTable[ entity.entity_type ].type;

						boolean bAnimateOnceType =
							(GAME_ENTITY_INFO_TYPE_PLAYER_ANIMATE_ONCE == type)
						||	(GAME_ENTITY_INFO_TYPE_ANIMATE_ONCE == type)
						||	(GAME_ENTITY_INFO_TYPE_SPECIAL_TIMER_A == type);
					
						if ( bAnimateOnceType ) {
						
//System.out.println( "entity_type " + entity.entity_type + " : type " + type + " : finished" );						

							entity.flags |= game_ENTITY_DEAD;

							SyncEntityToCurrentState( entity );

						}

					}
					
				}

			}
			
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_RENDER_ENTITIES );
			
		}

#if defined(DBUG_SIMPLE_PROFILER)
		gameState.simpleProfiler.End( pidB );
#endif

	}

	// ------------------------------------------------------------------------
	
#ifdef GAME_HAS_OVERLAYS

	INTERNAL_METHOD( void )
	GAME_RenderOverlays() {
	
	}
	
#endif

	// ------------------------------------------------------------------------
	
	//
	//	ProcessEntityMovementCmd()
	//
	
	INTERNAL_METHOD( void )
	ProcessEntityMovementCmd( game_ENTITY entity, short movement_flags )
	{
		// handle input as a modal operation, move or action 
		// --------------------------------------------------------------------

		if ( 0 != (GameInternals_INPUT_BUTTON_A & movement_flags) ) {

			if ( 0 == (game_ENTITY_BUTTON_DOWN & entity.flags) ) { // On button down

				// Perform button A action (rotate piece)
				// -------------------------------------------------------------

				entity.flags |= (game_ENTITY_BUTTON_DOWN | game_ENTITY_PENDING_TILE_ACTION);

				entity.pendingDirection = 0;

			}

		} else {

			entity.flags &= ~game_ENTITY_BUTTON_DOWN;

			// Okay now map the dpad to a direction request, only if not moving
			// ----------------------------------------------------------------

			boolean bOKToMove = 
				((0 == entity.delta_x) && (0 == entity.delta_y))
				|| ((entity.way_x == entity.x) && (entity.way_y == entity.y))
				|| (((entity.x + entity.delta_x) == entity.way_x) 
				&& ((entity.y + entity.delta_y) == entity.way_y))
				;
				
			if ( !bOKToMove ) return;

			if ( 0 != (GameInternals_INPUT_ANY_DPAD & movement_flags) ) {

				if ( 0 != (GameInternals_INPUT_DPAD_L & movement_flags) ) {

					entity.pendingDirection = GAME_TILE_INFO_L_OUT_CONNECT;

				}

				if ( 0 != (GameInternals_INPUT_DPAD_R & movement_flags) ) {

					entity.pendingDirection = GAME_TILE_INFO_R_OUT_CONNECT;

				}

				if ( 0 != (GameInternals_INPUT_DPAD_U & movement_flags) ) {

					entity.pendingDirection = GAME_TILE_INFO_U_OUT_CONNECT;

				}

				if ( 0 != (GameInternals_INPUT_DPAD_D & movement_flags) ) {

					entity.pendingDirection = GAME_TILE_INFO_D_OUT_CONNECT;

				}

			}

		}
	}

	// ------------------------------------------------------------------------
	
#if 0
	
	//
	//	EnableStreamEntity()
	//
	
	INTERNAL_METHOD( void )
	EnableStreamEntity( int stream, boolean bEnable ) {
	
		for ( int i = gameState.activeEntities; 0 <= --i; ) {
		
			short flags = gameState.entities[ i ].movement_type;
			
			if ( 0 != (ENTITY_MOVEMENT_USES_INPUT_STREAM_BIT & flags) ) {
			
				if ( (flags & ENTITY_MOVEMENT_INPUT_STREAM_MASK) == stream ) {
				
					if ( bEnable ) {
					
						gameState.entities[ i ].flags &= ~game_ENTITY_NOT_ACTIVE;
						
DBUG_TRACE_RUN( "ENABLE Entity " + i );
					
					} else {
					
						gameState.entities[ i ].flags |= game_ENTITY_NOT_ACTIVE;
						
DBUG_TRACE_RUN( "DISABLE Entity " + i );

					}
				
				}
			
			}
		
		}
	
	}
	
#endif
	
	// ------------------------------------------------------------------------

	//
	//	DecodeInputStreams()
	//

	INTERNAL_METHOD( void )
	DecodeInputStreams() {
	
		// --------------------------------------------------------------------
		
		for ( int i = MAX_INPUT_STREAMS; 0 <= --i; ) {
		
			gameState.inputStreams[ i ] = 0;
		
		}
		
		// --------------------------------------------------------------------
		
		boolean bResetInputStreams = false;

		gameState.inputStreams[ 0 ] = game_pad_flags;
		
#ifdef GAME_AUTOMATED_TESTING_HACK

		if ( HACKOLA_bAutomatedTesting ) {
		
			gameState.inputStreams[ 0 ] = (short)(rand() & GameInternals_INPUT_ANY_DPAD);
			
			if ( 0 == (rand() & 7) ) {
			
				gameState.inputStreams[ 0 ] |= GameInternals_INPUT_BUTTON_A;
			
			}
		
		}
		
#endif

		if ( gameState.inputStreamFrameIndex < gameState.intputStreamFrameCount ) {
		
			int index = gameState.inputStreamFrameIndex;
		
			if ( gameState.inputStreamFrame == gameState.inputStreamFramesTable[ index ] ) {

				int count = gameState.inputStreamFrameCmdCount[ index ];
				
				while ( 0 <= --count ) {
				
					// --------------------------------------------------------
					
					int stream = gameState.inputWhichStreamTable[ gameState.inputStreamCmdIndex ];
					
					short bits = gameState.inputCommandBitsTable[ gameState.inputStreamCmdIndex ];
				
					gameState.inputStreams[ stream ] = bits;
					
					++gameState.inputStreamCmdIndex;						
					
					// --------------------------------------------------------
					
					if ( 0 != (GameInternals_INPUT_END_LEVEL & bits) ) {
					
						gameState.status = GAME_STATE_SF_GOAL_MET;
					
					}
					
					// --------------------------------------------------------
					
					if ( 0 != (GameInternals_INPUT_RESET_STREAMS & bits) ) {
					
						bResetInputStreams = true;				
					
					}
									
					// --------------------------------------------------------
					
					if ( 0 != (GameInternals_INPUT_ENTITY_ACTION_BITS & bits) ) {
					
						for ( int i = gameState.activeEntities; 0 <= --i; ) {
						
							short movementFlags = gameState.entities[ i ].movement_type;
							
							if ( 0 != (ENTITY_MOVEMENT_USES_INPUT_STREAM_BIT & movementFlags) ) {
							
								if ( (movementFlags & ENTITY_MOVEMENT_INPUT_STREAM_MASK) == stream ) {
								
									// ----------------------------------------
									
									if ( 0 != (GameInternals_INPUT_UNPOSSESS_ENTITY & bits) ) {
									
										InitializeEntityAt(
											gameState.entities[ i ]
											,gameState.entities[ i ].entity_type
											,gameState.entities[ i ].map_x
											,gameState.entities[ i ].map_y
											,(short)0
											,false
											,false
											,0
										);
									
									}
									
									// ----------------------------------------
									
									int sound = 0;
									
									if ( 0 != (GameInternals_INPUT_ENABLE_ENTITY & bits) ) {
									
										gameState.entities[ i ].flags &= ~game_ENTITY_NOT_ACTIVE;
										
										sound = gameState.entityInfoTable[ gameState.entities[ i ].entity_type ].on_create_sound;
										
									} else if ( 0 != (GameInternals_INPUT_DISABLE_ENTITY & bits) ) {
									
										gameState.entities[ i ].flags |= game_ENTITY_NOT_ACTIVE;
										
										sound = gameState.entityInfoTable[ gameState.entities[ i ].entity_type ].on_destroy_sound;
										
									}
									
									if ( (0 != sound) ) {

										QueueSound( sound );

									}
										
									// ----------------------------------------
									
									if ( 0 != (GameInternals_INPUT_CLEAR_CONDITION_BITS & bits) ) {
									
										gameState.entities[ i ].ANIM_STATE_POLICY_ACCESS(animState,conditions_8) = 0;
									
									} else if ( 0 != (GameInternals_INPUT_ANY_CONDITION_BIT & bits) ) {
									
										gameState.entities[ i ].ANIM_STATE_POLICY_ACCESS(animState,conditions_8) =
											(byte)((bits & GameInternals_INPUT_ANY_CONDITION_BIT) >> 8);
									
									}
									
								}
								
							}
							
						}
						
					}
						
					// --------------------------------------------------------
					
					// ????
				
				}
			
				++gameState.inputStreamFrameIndex;
			
			}
			
			// ----------------------------------------------------------------
			
		}
		
		// --------------------------------------------------------------------
		
		if ( bResetInputStreams ) {
		
			gameState.inputStreamFrameIndex = 0;
			gameState.inputStreamCmdIndex = 0;
			gameState.inputStreamFrame = 0;
			
		} else {

			++gameState.inputStreamFrame;
			
		}
		
	}

	// ------------------------------------------------------------------------
	
	//
	//	GAME_ChangeEntitiesToEndOfLevelType()
	//

	INTERNAL_METHOD( int )
	GAME_ChangeEntitiesToEndOfLevelType( int findType )
	{
		int conversionCount = 0;

		for ( int i = 0; i < gameState.activeEntities; i++ ) {

			game_ENTITY entity = gameState.entities[ i ];

			game_ENTITY_INFO entityInfo = 
				gameState.entityInfoTable[ entity.entity_type ];

			if ( findType == entityInfo.type ) {

				if ( -1 != entityInfo.change_type_to_upon_death ) {

					++conversionCount;

					ChangeEntityToType(
						entity
						,entityInfo.change_type_to_upon_death
						,false
					);

				}
			}

		}

		return conversionCount;
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	SetEntityPosition()
	//
	
	INTERNAL_METHOD( void )
	SetEntityPosition(
		game_ENTITY entity
		,short map_x
		,short map_y
	)
	{
		entity.map_x = map_x;
		entity.map_y = map_y;
		entity.x = (short)((entity.map_x * GAME_TILE_PIXELS_CX) + GAME_TILE_PIXELS_CX/2);
		entity.y = (short)((entity.map_y * GAME_TILE_PIXELS_CY) + GAME_TILE_PIXELS_CY/2);
		entity.way_x = entity.x;
		entity.way_y = entity.y;
		entity.delta_x = 0;
		entity.delta_y = 0;
	}
	
	//
	//	InitializeEntityAt()
	//
	
	INTERNAL_METHOD( void )
	InitializeEntityAt(
		game_ENTITY entity
		,short entity_type
		,short map_x
		,short map_y
		,short override_movement_type
		,boolean bTriggerSounds
		,boolean bOverrideClassValue
		,int override_class_value
	)
	{
		game_ENTITY_INFO entityInfo = gameState.entityInfoTable[ entity_type ];

		short newAnim = entityInfo.anim_d;
		
		entity.entity_type = entity_type;
		entity.ANIM_STATE_POLICY_ACCESS(animState,animation) = newAnim;
		entity.ANIM_STATE_POLICY_ACCESS(animState,frame) = 0;
		entity.ANIM_STATE_POLICY_ACCESS(animState,conditions_8) = 0;
		entity.flags = 0;
		entity.rndGeneratorData = ((entity_type * 7) + entity_type) + 1;

#if !defined(OLD_RND_GENERATOR_SEED_POLICY)
		entity.rndGeneratorData += (map_x + (map_y * gameState.active_w));
#endif

		entity.pendingDirection = 0;
		entity.health = entityInfo.initial_health;
		
#if !defined(USE_ANIM_STATE_CLASS)

		entity.ANIM_STATE_POLICY_ACCESS(animState,last_frame) = currentAnimEngine.LastFrame( newAnim );

#endif

		// --------------------------------------------------------------------
		// entity class related info
		// --------------------------------------------------------------------
		
#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

		if ( bOverrideClassValue ) {
		
			entity.class_value = override_class_value;
			
			if ( entity.class_value > entityInfo.class_value_max ) {

				entity.class_value = entityInfo.class_value_max;

			}
			
			if ( entity.class_value < entityInfo.class_value_min ) {

				entity.class_value = entityInfo.class_value_min;

			}
			
		} else {

			entity.class_value = entityInfo.class_value_default;
			
		}
		
#endif // class value added (8/31/03)

		// --------------------------------------------------------------------
		
		if ( 0 != (ENTITY_MOVEMENT_OVERRIDE_DEFAULT & override_movement_type) ) {
		
			entity.movement_type = override_movement_type;
		
		} else {
		
			entity.movement_type = entityInfo.default_movement_type;
			
		}
		
		SetEntityPosition( entity, map_x, map_y );
		
		// --------------------------------------------------------------------
		// play audio here?
		// --------------------------------------------------------------------
		
		if ( bTriggerSounds && (0 != entityInfo.on_create_sound) ) {

			QueueSound(
				entityInfo.on_create_sound
			);

		}
		
	}
	
	// --------------------------------------------------------------------
	
	//
	//	rand()
	//
	
	static private Random rnd = new Random();
	
	INTERNAL_METHOD( int )
	rand() {
	
		int value = rnd.nextInt();
		
		return (0 > value) ? -value : value;
	
	}

	// --------------------------------------------------------------------

	//
	//	HACKOLA_GenerateRandomLevel()
	//
	
#if defined(GAME_RANDOM_LEVEL_GENERATOR)

	INTERNAL_METHOD( void )
	HACKOLA_GenerateRandomLevel()
	{
		if ( null == gameState ) return;
		
		if ( !gameState.bValid ) return;
		
		gameState.status = 0;
		gameState.frame = 0;
		
		// ----------------------------------------------------------------
		
		MarkEntireBackgroundAsChanged();
		
		// ----------------------------------------------------------------
		
		gameState.intputStreamFrameCount = 0;
		gameState.inputStreamFrameIndex = 0;
		gameState.inputStreamCmdIndex = 0;
		gameState.inputStreamFrame = 0;
			
		// setup the board
		// ----------------------------------------------------------------

		gameState.active_w = 5;

		gameState.active_h = 5;
		
		int mapIndex = 0;

		for ( int y = 0; y < gameState.active_h; y++ ) {

			for ( int x = 0; x < gameState.active_w; x++ ) {
			
				gameState.map_condition_8s[ mapIndex ] = 0;
			
				gameState.map[ mapIndex ] = (short)(rand() % gameState.tileInfoTable.length);
				
				++mapIndex;
				
			}
			
		}
		
		// okay fill out the entity list...
		// ----------------------------------------------------------------

		gameState.activeEntities = (short)gameState.entityInfoTable.length;

		for ( int i = 0; i < gameState.activeEntities; i++ ) {
		
			int x = 0;
			int y = 0;

			if ( 0 != i ) {

				for ( short j = 0; j < 16; j++ ) {

					x = rand() % gameState.active_w;

					y = rand() % gameState.active_h;

					if ( (x != (gameState.active_w/2)) && (y != (gameState.active_h/2)) ) {

						break;

					}

				}

			} else {

				x = gameState.active_w/2;
				y = gameState.active_h/2;

			}

			InitializeEntityAt( gameState.entities[ i ], (short)i, (short)x, (short)y, (short)0, true, false, 0 );
			
		}

	}
	
#endif // defined(GAME_RANDOM_LEVEL_GENERATOR)

	// ------------------------------------------------------------------------
	
	//
	//	LEVEL_LoadFromFile()
	//

	INTERNAL_METHOD( boolean )
	LEVEL_LoadFromFile(
		String filename
		,boolean bUseHttp
		,boolean bAllowEntityRemap
	)
	{
		// --------------------------------------------------------------------
		
		gameState.status = 0;
		gameState.frame = 0;
		
		// ----------------------------------------------------------------
		
		MarkEntireBackgroundAsChanged();
		
		// --------------------------------------------------------------------
		
		CFileReader inFile = null;
		
		try {
	
	DBUG_TRACE_LOAD( filename + ":" + bUseHttp );
	
			inFile = new CFileReader();
			
			if ( !inFile.Open( filename, bUseHttp ) ) {
			
				inFile = null;
				return false;
		
			}
			
			int chunkSize = inFile.Read_16();
			
			// --------------------------------------------------------------------
			
			inFile.Read_Validate_DECAFBAD();

			// --------------------------------------------------------------------
			
			int even_r = inFile.ReadByte();
			int even_g = inFile.ReadByte();
			int even_b = inFile.ReadByte();

			int odd_r = inFile.ReadByte();
			int odd_g = inFile.ReadByte();
			int odd_b = inFile.ReadByte();
			
			currentAnimEngine.SetBGColor( even_r, even_g, even_b, odd_r, odd_g, odd_b );
				
			// --------------------------------------------------------------------
			// okay read the map
			// --------------------------------------------------------------------
			
			int w = inFile.ReadByte();
			int h = inFile.ReadByte();
			
			gameState.active_w = (short)w;
			gameState.active_h = (short)h;
			
			inFile.Read_Validate_16( (short)0xDEAD );
			
			int index = 0;
			
			for ( int r = 0; r < h; r++ ) {
			
				for ( int c = 0; c < w; c++ ) {
				
					gameState.map_condition_8s[ index ] = 0;
					
					gameState.map[ index ] = (short)inFile.ReadByte();

					++index;
				
				}
			
			}
			
			inFile.Read_Validate_16( (short)0xBEEF );
			
			// --------------------------------------------------------------------
			
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			MarkEntireBackgroundAsChanged();
			
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

			// --------------------------------------------------------------------
			// okay read the entities
			// --------------------------------------------------------------------
			
#if defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)
			if ( bAllowEntityRemap ) {
			
				bAllowEntityRemap = policy_SwapMainCharacter;
			
			}
#endif // defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)
			
			// --------------------------------------------------------------------
			
			int entityCount = inFile.ReadByte();
			
			gameState.activeEntities = (short)entityCount;
			
			boolean bReadMovementTypeOverride = (0 != inFile.ReadByte()); // neeed to determine if we need to read these
			
			inFile.Read_Validate_16( (short)0xDEAD );
			
			for ( int i = 0; i < entityCount; i++ ) {
			
				short entityType = (short)inFile.ReadByte();
				
#if defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				if ( bAllowEntityRemap ) {
				
					for ( int r = gameState.remap_EntityTableSize; 0 <= --r; ) {
					
						if ( entityType == gameState.remap_SrcEntity[ r ] ) {
						
				DBUG_TRACE_ENTITY_REMAPPING( "remapping " + entityType + " to " + gameState.remap_DstEntity[ r ] );
							
							entityType = gameState.remap_DstEntity[ r ];
							
							break;
						
						}
					
					}
				
				}
				
#endif // defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				short map_x = (short)inFile.ReadByte();
				
				short map_y = (short)inFile.ReadByte();
				
				short override_movement_type; // optional read
				
				if ( bReadMovementTypeOverride ) {
				
					override_movement_type = (short)inFile.Read_16();
					
				} else {
				
					override_movement_type = 0;
				
				}
			
				InitializeEntityAt(
					gameState.entities[ i ]
					,entityType
					,map_x
					,map_y
					,override_movement_type
					,true
					,false
					,0
				);
		
			}
			
			inFile.Read_Validate_16( (short)0xBEEF );
			
			// ----------------------------------------------------------------
			// okay read the input streams
			// ----------------------------------------------------------------
			
			int streamFramesCount = inFile.Read_16();
			
DBUG_TRACE_LOAD( "streamFramesCount:" + streamFramesCount );
			
			gameState.intputStreamFrameCount = (short)streamFramesCount;
			
			gameState.inputStreamFrameIndex = 0;
			
			gameState.inputStreamCmdIndex = 0;
			
			gameState.inputStreamFrame = 0;
			
			if ( 0 != streamFramesCount ) {
			
				int streamCmdCount = inFile.Read_16();
				
DBUG_TRACE_LOAD( "streamCmdCount:" + streamCmdCount );

				// allocate the frames tables
				// ------------------------------------------------------------
				
				if ( null != gameState.inputStreamFramesTable ) {
				
					if ( streamFramesCount > gameState.inputStreamFramesTable.length ) {
					
						gameState.inputStreamFramesTable = null;
					
					}
				
				}
				
				if ( null == gameState.inputStreamFramesTable ) {
				
					gameState.inputStreamFramesTable = new short [ streamFramesCount ];
					gameState.inputStreamFrameCmdCount = new byte [ streamFramesCount ];
				
				}
				
				// allocate the command tables
				// ------------------------------------------------------------
				
				if ( null != gameState.inputWhichStreamTable ) {
				
					if ( streamCmdCount > gameState.inputWhichStreamTable.length ) {
					
						gameState.inputWhichStreamTable = null;
						gameState.inputCommandBitsTable = null;
					
					}
				
				}
				
				if ( null == gameState.inputWhichStreamTable ) {
				
					gameState.inputWhichStreamTable = new byte [ streamCmdCount ];
					gameState.inputCommandBitsTable = new short [ streamCmdCount ];
				
				}
				
				// ------------------------------------------------------------
				
				inFile.Read_Validate_16( (short)0xDEAD );
				
				int cmdIndex = 0;
				
				for ( int i = 0; i < streamFramesCount; i++ ) {
				
					short packed = inFile.Read_16();
					
					gameState.inputStreamFramesTable[ i ] = (short)(packed & 0x0FFF);
					
					gameState.inputStreamFrameCmdCount[ i ] = (byte)((packed >> 12) & 0x0F);
					
DBUG_TRACE_LOAD( "Frame:" + gameState.inputStreamFramesTable[ i ] + ":Count:" + gameState.inputStreamFrameCmdCount[ i ] );

					for ( int count = gameState.inputStreamFrameCmdCount[ i ]; 0 <= --count; ) {
					
						int cmdValue = inFile.ReadByte();
						
						gameState.inputWhichStreamTable[ cmdIndex ] = (byte)(cmdValue >> 4);
						
DBUG_TRACE_LOAD( "\tSTM:" + (cmdValue >> 4) );
DBUG_TRACE_LOAD( "\tCMD:" + (cmdValue & INPUT_STREAM_CMD_MASK) );

						int value = 0;
						
						switch ( cmdValue & INPUT_STREAM_CMD_MASK ) {
						
						case INPUT_STREAM_CMD_UP:
							value = GameInternals_INPUT_DPAD_U;
							break;
							
						case INPUT_STREAM_CMD_RIGHT:
							value = GameInternals_INPUT_DPAD_R;
							break;
							
						case INPUT_STREAM_CMD_DOWN:
							value = GameInternals_INPUT_DPAD_D;
							break;
							
						case INPUT_STREAM_CMD_LEFT:
							value = GameInternals_INPUT_DPAD_L;
							break;
							
						case INPUT_STREAM_CMD_BUTTON_A:
							value = GameInternals_INPUT_BUTTON_A;
							break;
							
						case INPUT_STREAM_CMD_FULL_INPUT:
							value = inFile.Read_16();
							break;
							
						case INPUT_STREAM_CMD_END_LEVEL:
							value = GameInternals_INPUT_END_LEVEL;
							break;

						case INPUT_STREAM_CMD_ENABLE_ENTITY:
							value = GameInternals_INPUT_ENABLE_ENTITY;
							break;
							
						case INPUT_STREAM_CMD_DISABLE_ENTITY:
							value = GameInternals_INPUT_DISABLE_ENTITY;
							break;
							
						// ----------------------------------------------------
							
						case INPUT_STREAM_CMD_RESET_STREAMS:
							value = GameInternals_INPUT_RESET_STREAMS;
							break;
							
						case INPUT_STREAM_CMD_UNPOSSESS_ENTITY:
							value = GameInternals_INPUT_UNPOSSESS_ENTITY;
							break;
							
						case INPUT_STREAM_CMD_SET_CONDITION_BIT:
							value = ((inFile.ReadByte() & 0x0f) << 8);
							break;
							
						case INPUT_STREAM_CMD_CLEAR_CONDITION_BITS:
							value = GameInternals_INPUT_CLEAR_CONDITION_BITS;
							break;
							
						// ----------------------------------------------------
						
						}
						
						gameState.inputCommandBitsTable[ cmdIndex++ ] = (short)value;
					
					}					
				
				}
				
				// ------------------------------------------------------------
				
				inFile.Read_Validate_16( (short)0xBEEF );
				
			}
			
			// ----------------------------------------------------------------
			// Read sound concepts (sound remapping)
			// ----------------------------------------------------------------
			
#if defined(POLICY_RESET_LOGICAL_SOUNDS_EVERY_LEVEL)
				
			currentSoundManager.ResetLogicalSounds();
			
#endif // defined(POLICY_RESET_LOGICAL_SOUNDS_EVERY_LEVEL)

			int remapSoundCount = inFile.ReadByte();
			
			if ( 0 != remapSoundCount ) {
				
#if !defined(POLICY_RESET_LOGICAL_SOUNDS_EVERY_LEVEL)
				
				currentSoundManager.ResetLogicalSounds();
			
#endif // !defined(POLICY_RESET_LOGICAL_SOUNDS_EVERY_LEVEL)

				inFile.Read_Validate_16( (short)0xDEAD );
				
				for ( int snd = 0; snd < remapSoundCount; snd++ ) {
				
					byte logicalSound = (byte)inFile.ReadByte();
					
					byte physicalSound = (byte)inFile.ReadByte();
					
					currentSoundManager.AssociateLogicalSound( logicalSound, physicalSound );
				
				}
				
				inFile.Read_Validate_16( (short)0xBEEF );
				
			}
			
			// ----------------------------------------------------------------
			// ----------------------------------------------------------------
			
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_LOAD_LEVEL_DATA );
			
			return false;
			
		} finally {
		
			if ( null != inFile ) {
			
				inFile.Close();
				inFile = null;
			
			}
		}
		
		// --------------------------------------------------------------------
		
		return true;
	}
	
	// ------------------------------------------------------------------------
	
	// ------------------------------------------------------------------------
	
	//
	// PrepareLevelInternals()
	//
	
	INTERNAL_METHOD( void )
	PrepareLevelInternals() {
	
#if defined(GAME_HAS_A_TILE_CURSOR)

		gameState.cursor_map_x = (short)(gameState.active_w >> 1);
		gameState.cursor_map_y = (short)(gameState.active_h >> 1);
		
#endif // defined(GAME_HAS_A_TILE_CURSOR)

		// --------------------------------------------------------------------

#if defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

		if ( LEVEL_TYPE_FOODCHAIN_SCORE == gameState.currentLevelType ) {
		
			// find the 'GAME_ENTITY_INFO_TYPE_SPECIAL_INDICATOR' in the map
			
			game_ENTITY_INFO entityInfo;
			
			game_ENTITY entity;
			
			gameState.foodchain_SpecialEntities.removeAllElements();
			
			for ( int i = 0; i < gameState.activeEntities; i++ ) {
			
				entity = gameState.entities[ i ];
			
				entityInfo = gameState.entityInfoTable[ entity.entity_type ];
				
				if ( GAME_ENTITY_INFO_TYPE_SPECIAL_INDICATOR == entityInfo.type ) {
				
					gameState.foodchain_SpecialEntities.addElement( (Object) entity );
				
				}
				
			}
			
		} // handle other level types

#else
	
/*

	NOTE
	
		this code is not exactly general purpose...

*/

		// Setup any of the necessary tile conditions 
		// --------------------------------------------------------------------
		
		boolean bHasLevelActions = false;
		
		{
			int mapIndex = 0;
			
			for ( int y = 0; y < gameState.active_h; y++ ) {
			
				for ( int x = 0; x < gameState.active_w; x++ ) {
				
					int action_type = gameState.tileInfoTable[ gameState.map[ mapIndex ] ].action_type;
					
					if ( (TILE_ACTION_GOTO_LEVEL_1 <= action_type) &&
						(TILE_ACTION_GOTO_LEVEL_100 >= action_type) ) {
						
						bHasLevelActions = true;
						
						byte bits_8 = 0;
						
						int level = (action_type - TILE_ACTION_GOTO_LEVEL_1) + 1;
						
						// ----------------------------------------------------
						
						if ( level <= gameState.saved_HighestUnlockedLevel  ) {
						
							bits_8 |= 0x01;
						
						}
						
						// ----------------------------------------------------
						
						if ( 24 >= level ) {
						
							int level_bit = 1 << (level - 1);
							
							if ( 0 != (level_bit & gameState.saved_CollectedHeartBits) ) {
							
								bits_8 |= 0x02;
								
							}
						
						}
						
						// ----------------------------------------------------
						
						gameState.map_condition_8s[ mapIndex ] = bits_8;
						
					}		
					
					++mapIndex;
				
				}
				
			}
			
		}
	
		// if on a level selection level then try to place any level blockers
		// (eventually this would be a level goal type, which would need to be
		// able to search for specific bit patterns in the conditions map...)
		// --------------------------------------------------------------------
		
		if ( bHasLevelActions ) {
		
			int firstUnfinishedLevel = 0;
			
			int unfinishedLevelMapIndex = 0;
			
			for ( int level = 1; level <= 24; level++ ) {
			
				unfinishedLevelMapIndex = GetMapIndexForLevel( level );
				
				if ( -1 == unfinishedLevelMapIndex ) continue;
				
				int action_type = gameState.tileInfoTable[ gameState.map[ unfinishedLevelMapIndex ] ].action_type;
				
				if ( (TILE_ACTION_GOTO_LEVEL_1 <= action_type) &&
					(TILE_ACTION_GOTO_LEVEL_100 >= action_type) && 
					(0 == (0x02 & gameState.map_condition_8s[ unfinishedLevelMapIndex ]))
					) {
				
					firstUnfinishedLevel = level;
					
					break;
				
				}
			
			}
			
			if ( 0 != firstUnfinishedLevel ) {
			
				short map_x = (short)(unfinishedLevelMapIndex % gameState.active_w);
				
				short map_y = (short)(unfinishedLevelMapIndex / gameState.active_w);
				
				for ( int i = 0; i < gameState.activeEntities; i++ ) {
				
					if ( GAME_ENTITY_INFO_TYPE_UNFINISHED_LEVEL_BLOCKER == 
						gameState.entityInfoTable[ gameState.entities[ i ].entity_type ].type ) {
					
						InitializeEntityAt(
							gameState.entities[ i ]
							,gameState.entities[ i ].entity_type
							,map_x
							,map_y
							,(short)0
							,true
							,false
							,0
						);
						
//					System.out.println( "blocker entity " + i + " level " + firstUnfinishedLevel );
//					System.out.println( "\tat " + map_x + "," + map_y );
						
						// set the current level to the first unfinished level if one.
						// once Mitzy is done falling down then Burt needs to reappear there.
						
						gameState.currentLevelNumber = (byte)firstUnfinishedLevel;
					
					}
				
				}
				
			}
				
		}
		
#endif // defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)
		
		// --------------------------------------------------------------------
		
	}	
	
	// ------------------------------------------------------------------------
	
	//
	//	HACKOLA_LoadLevelNumber()
	//

	INTERNAL_METHOD( boolean )
	HACKOLA_LoadLevelNumber( byte number, boolean bAllowCutScenes )
	{
		String filename;
	
		try {
		
			// check to see if trying to request a level beyond the end...
			// ----------------------------------------------------------------
			
			if ( number >= gameState.level_data_type.length ) {
			
				number = 0;
			
			}
		
			// check to see if there is a cut scene
			// ----------------------------------------------------------------
			
			if ( bAllowCutScenes ) {
			
				// ------------------------------------------------------------
				
#if defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

				byte orignalNumber = number;
				
#endif // defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

				// ------------------------------------------------------------
			
				while ( 0 != gameState.level_data_cut_scene[ number ] ) {
				
					gameState.levelStack.push( new Integer( number ) );
					
					number = gameState.level_data_cut_scene[ number ];
					
				}
				
				// ------------------------------------------------------------
				
#if defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

				if ( orignalNumber != number ) {
				
					if ( 24 >= orignalNumber ) {
					
						int theLevelBit = (1 << (orignalNumber - 1));
						
						if ( 0 == (theLevelBit & gameState.playedCutsceneBits) ) {
						
							gameState.playedCutsceneBits |= theLevelBit;
						
						} else {
						
							number = orignalNumber;
							
							gameState.levelStack.removeAllElements();
						
						}
					
					}
				
				}
			
#endif // defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

			}
			
			// ----------------------------------------------------------------
			
			filename = baseFilesURL + "-" + number + ".lvl";
		
			boolean bLoadedResult = LEVEL_LoadFromFile(
				filename
				,bUseHttpForURL
				,0 == (0x80 & gameState.level_data_type[ number ]) 
			);
			
			if ( bLoadedResult ) {
			
				gameState.currentLevelNumber = number;
			
				gameState.currentLevelType = (byte)(gameState.level_data_type[ number ] & 0x7F); // LEVEL_TYPE_NORMAL; // HACK
				
				// initialize level type
				// ------------------------------------------------------------
				
				PrepareLevelInternals();
				
			}
			
			return bLoadedResult;
		
		} finally {
		
			filename = null;
		
		}
		
	}

	// ------------------------------------------------------------------------
	
	//
	//	GetMapIndexForLevel
	//

#if !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

	INTERNAL_METHOD( int )
	GetMapIndexForLevel( int level ) {
	
		int mapIndex = 0;
		
		int action_type = level - 1 + TILE_ACTION_GOTO_LEVEL_1;
	
		for ( int y = 0; y < gameState.active_h; y++ ) {
		
			for ( int x = 0; x < gameState.active_w; x++ ) {
			
				if ( action_type == gameState.tileInfoTable[ gameState.map[ mapIndex ] ].action_type ) {
				
					return mapIndex; // (x + (y * gameState.active_w));
				
				}
				
				++mapIndex;
			
			}
			
		}
		
		return -1;
	}
	
#endif // !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

	//
	//	DetermineDirectionBetweenLevels()
	//
	
#if !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

	INTERNAL_METHOD( int )
	DetermineDirectionBetweenLevels( int fromLevel, int toLevel )
	{
		int fromIndex = GetMapIndexForLevel( fromLevel );
		
		if ( -1 == fromIndex ) return 0;
		
		int toIndex = GetMapIndexForLevel( toLevel );
		
		if ( -1 == toIndex ) return 0;
		
		int delta = toIndex - fromIndex;
		
		if ( -1 == delta ) {
		
			return GAME_TILE_INFO_L_OUT_CONNECT;
		
		} else if ( 1 == delta ) {
		
			return GAME_TILE_INFO_R_OUT_CONNECT;
			
		} else if ( -gameState.active_w == delta ) {
		
			return GAME_TILE_INFO_U_OUT_CONNECT;
			
		} else if ( gameState.active_w == delta ) {
		
			return GAME_TILE_INFO_D_OUT_CONNECT;
			
		}
		
		return 0;
	}
	
#endif // !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)
	
	//
	//	PlaceEntityOnLevelTile()
	//
	
#if !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

	INTERNAL_METHOD( int )
	PlaceEntityOnLevelTile( game_ENTITY entity, int level ) {
	
		int mapIndex = GetMapIndexForLevel( level );
		
		if ( -1 != mapIndex ) {
		
			SetEntityPosition(
				entity
				,(short)(mapIndex % gameState.active_w)
				,(short)(mapIndex / gameState.active_w)
			);
			
		}
		
		return mapIndex;
		
	}
	
#endif // !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

	// ------------------------------------------------------------------------
	
	//
	//	ReturnToLevelSelection()
	//
	
	EXTERNAL_METHOD( void )
	ReturnToLevelSelection()
	{
		// If there was an active cut scene make at as if we played it
		// --------------------------------------------------------------------
		
		while ( !gameState.levelStack.empty() ) {
		
			Integer level = (Integer)gameState.levelStack.pop();
		
			gameState.currentLevelNumber = level.byteValue();
		
		}

		// now continue with returning to the level selection level.
		// --------------------------------------------------------------------
		
		gameState.status = GAME_STATE_SF_PLAYER_DEAD;
		
		HandleEndOfLevel();
	}
	
	// ------------------------------------------------------------------------
	
#if defined(FOOD_CHAIN_CAGE_INFO)

	//
	//	FOODCHAIN_FindCagedAnimals()
	//

	INTERNAL_METHOD( void )
	FOODCHAIN_FindCagedAnimals() {
	
		// --------------------------------------------------------------------
		
		int filledCageCount = gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_UNTOUCHABLE_GOAL ];

		int cagedAnimals = gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_CAGED_ANIMAL ];

		if ( 0 == cagedAnimals ) return;
		
		boolean bNeedToResizeOrAllocate = (null == gameState.foodchain_CagedAnimalsInformation);
		
		if ( !bNeedToResizeOrAllocate ) {
		
			bNeedToResizeOrAllocate = (filledCageCount > gameState.foodchain_CagedAnimalsInformation.length);
		
		}
		
		if ( bNeedToResizeOrAllocate ) {
		
			gameState.foodchain_CagedAnimalsInformation = null; 
			
			gameState.foodchain_CagedAnimalsInformation = new CagedAndAnimalInfo [ filledCageCount ];
			
			for ( int i = 0; i < filledCageCount; i++ ) {
			
				gameState.foodchain_CagedAnimalsInformation[ i ] = new CagedAndAnimalInfo();
			
			}
		
		}
		
		int nextIndex = 0;
		
		// --------------------------------------------------------------------
		
		for ( int i = 0; i < gameState.activeEntities; i++ ) {
		
			game_ENTITY cageEntity = gameState.entities[ i ];
		
			if ( 0 != (game_ENTITY_NOT_ACTIVE & cageEntity.flags) 
				|| (GAME_ENTITY_INFO_TYPE_UNTOUCHABLE_GOAL != gameState.entityInfoTable[ cageEntity.entity_type ].type) ) {
				
				continue;
				
			}
			
			for ( int j = 0; j < gameState.activeEntities; j++ ) {
			
				game_ENTITY animalEntity = gameState.entities[ j ];
				
				if ( (i == j) || (0 != (game_ENTITY_NOT_ACTIVE & animalEntity.flags) 
					|| (GAME_ENTITY_INFO_TYPE_CAGED_ANIMAL != gameState.entityInfoTable[ animalEntity.entity_type ].type))
					|| ((animalEntity.map_x != cageEntity.map_x) || (animalEntity.map_y != cageEntity.map_y))
					) {
					
					continue;
					
				}
				
				gameState.foodchain_CagedAnimalsInformation[ nextIndex ].animal_entity_type = 
					gameState.entityInfoTable[ animalEntity.entity_type ].change_type_to_upon_collision;
					
				gameState.foodchain_CagedAnimalsInformation[ nextIndex ].animal_class_value = animalEntity.class_value;
				
				gameState.foodchain_CagedAnimalsInformation[ nextIndex ].cage_entity_type = 
					gameState.entityInfoTable[ cageEntity.entity_type ].change_type_to_upon_collision;
					
				gameState.foodchain_CagedAnimalsInformation[ nextIndex ].cage_class_value = cageEntity.class_value;
				
				++nextIndex;
				
			}
			
		}
	
		gameState.foodchain_CagedAnimalCount = (byte)nextIndex;
		
		gameState.foodchain_NextCage = 0;
		
		gameState.foodchain_CurrentCage = -1;
		
	}

#endif // defined(FOOD_CHAIN_CAGE_INFO)
	
	// ------------------------------------------------------------------------
	
#if defined(GAME_USES_MESSAGE_STRINGS)

	//
	//	AfterFrameDisplayMessage()
	//
	
	INTERNAL_METHOD( void )
	AfterFrameDisplayMessage( String title, String messageText, String imageName ) {
	
		messageTitleString = title;
		
		messageTextString = messageText;
		
		messageImageString = imageName;
	
	}

#endif // defined(GAME_USES_MESSAGE_STRINGS)

	// ------------------------------------------------------------------------
	
#if defined(FOOD_CHAIN_LEVEL_GOALS)

	//
	//	FOODCHAIN_FinishedGame()
	//

	INTERNAL_METHOD( void )
	FOODCHAIN_FinishedGame() {
	
		// Collect pending points
		// --------------------------------------------------------------------
		
		for ( int i = 0; i < gameState.foodchain_CagedAnimalCount; i++ ) {
		
			AddToScore(
				gameState.foodchain_CagedAnimalsInformation[ i ].animal_class_value *
				gameState.foodchain_CagedAnimalsInformation[ i ].cage_class_value
			);
		
		}
		
		gameState.foodchain_CagedAnimalCount = 0;
		
		int finalScore = gameState.saved_CurrentScore;
		
		// --------------------------------------------------------------------
		
		ClearSavedGame();
			
		// --------------------------------------------------------------------
		
		String imageString;
		
		if ( finalScore == gameState.saved_HighestScore ) {
		
			imageString = "/res/won_top.png";
		
		} else {
		
			imageString = "/res/won.png";
			
		}
	
		// --------------------------------------------------------------------
		
		AfterFrameDisplayMessage(
			"Finished!"
			,	"Finished, score " + finalScore
				+ " (top " + 
				+ gameState.saved_HighestScore 
				+ " )"
			,imageString
		);
	
	}

	//
	//	FOODCHAIN_GameOver()
	//

	INTERNAL_METHOD( void )
	FOODCHAIN_GameOver() {
	
		int finalScore = gameState.saved_CurrentScore;
	
		ClearSavedGame();
		
		// --------------------------------------------------------------------
		
		String imageString;
		
		if ( finalScore == gameState.saved_HighestScore ) {
		
			imageString = "/res/lost_top.png";
		
		} else {
		
			imageString = "/res/lost.png";
			
		}
	
		// --------------------------------------------------------------------
		
		AfterFrameDisplayMessage(
			"Game Over"
			,	"Score " + finalScore
				+ " (top " + 
				+ gameState.saved_HighestScore 
				+ " ), try again"
			,imageString
		);
		
		// --------------------------------------------------------------------
		
	}

#endif // defined(FOOD_CHAIN_LEVEL_GOALS)

	// ------------------------------------------------------------------------
	
	//
	//	HandleEndOfLevel()
	//
	
	INTERNAL_METHOD( boolean )
	HandleEndOfLevel() {
	
		// check to see if there is a level pushed on the stack to goto.
		// --------------------------------------------------------------------
		
		if ( !gameState.levelStack.empty() ) {
		
			Integer level = (Integer)gameState.levelStack.pop();
		
			HACKOLA_LoadLevelNumber( level.byteValue(), false ); // level selection level...
			
			return true;
			
		}
	
		// remember the current level and load the level selection level
		// --------------------------------------------------------------------

		int theLevel = gameState.currentLevelNumber;
		
		int nextLevel = theLevel;
		
		if ( 0 != (GAME_STATE_SF_GOAL_MET & gameState.status) ) {
		
			// ----------------------------------------------------------------
	
#if defined(FOOD_CHAIN_CAGE_INFO)

			FOODCHAIN_FindCagedAnimals();

#endif // defined(FOOD_CHAIN_CAGE_INFO)
	
			// ----------------------------------------------------------------
	
			gameState.status = GAME_STATE_SF_END_OF_LEVEL;
			
			// Check to see if there is a 'next' otherwise assume goto the next number
			// first stopping on the level selection level
			
			if ( 0 != gameState.level_data_next[ theLevel ] ) {
			
				HACKOLA_LoadLevelNumber( (byte)gameState.level_data_next[ theLevel ], true );
				
				return true;
				
			} else {
			
#if defined(FOOD_CHAIN_LEVEL_GOALS)

				if ( LEVEL_TYPE_LAST_GAME_LEVEL != gameState.level_data_type[ theLevel ] ) {
				
					++nextLevel;
					
				} else {
				
					FOODCHAIN_FinishedGame();
					
					nextLevel = 0;
				
				}

#else // defined(FOOD_CHAIN_LEVEL_GOALS)
			
				++nextLevel;
				
#endif // defined(FOOD_CHAIN_LEVEL_GOALS)
				
			}
		
		} else if ( 0 != (GAME_STATE_SF_PLAYER_DEAD & gameState.status) ) {
		
			gameState.status = GAME_STATE_SF_END_OF_LEVEL;
			
#if defined(FOOD_CHAIN_LEVEL_GOALS)

			FOODCHAIN_GameOver();

			nextLevel = 0;
			
#endif // defined(FOOD_CHAIN_LEVEL_GOALS)

		} else {
		
			return false;
		
		}
		
		// track the highest level
		// --------------------------------------------------------------------
		
		boolean bSaveGameState = false;
		
		if ( nextLevel > gameState.saved_HighestUnlockedLevel ) {
		
			gameState.saved_HighestUnlockedLevel = (byte)nextLevel;
			
			bSaveGameState = true;

		}
		
		if ( gameState.last_SavedCollectedHeartBits != gameState.saved_CollectedHeartBits ) {
		
			bSaveGameState = true;
			
		}
		
		if ( bSaveGameState ) {
		
			SaveGameState();
		
		}

		// load the level selection level		
		// --------------------------------------------------------------------
		
		HACKOLA_LoadLevelNumber( (byte)0, true ); // level selection level...
		
		// check to see if there is a spot for the next level, if there isn't
		// a spot then just load the next level and start it.
		
#if !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

		if ( -1 != GetMapIndexForLevel( nextLevel ) ) {
		
			PlaceEntityOnLevelTile( gameState.entities[ 0 ], theLevel );	
		
			if ( theLevel != nextLevel ) {
			
				// make the player automatically walk to the next level
				
				gameState.entities[ 0 ].pendingDirection = DetermineDirectionBetweenLevels(
					theLevel, nextLevel
				);
				
			} else {
			
				gameState.entities[ 0 ].pendingDirection = 0;
			
			}
		
		} else {
		
			HACKOLA_LoadLevelNumber( (byte)nextLevel, true );
			
		}
		
#endif // !defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

		game_pad_flags = 0;
		
		return true;		
	}
	
	// ------------------------------------------------------------------------
	
/*

	THIS GOAL SYSTEM WILL EVENTUALLY BE REPLACED BY GENERIC GOAL TYPES
	WHERE POSSIBLE!!!

*/

	// ========================================================================
	
	//
	//	AddToScore()
	//

#if defined(GAME_HAS_SCORE_AND_HISCORE)

	INTERNAL_METHOD( void )
	AddToScore( int delta ) {
	
		gameState.saved_CurrentScore += delta;
		
		if ( gameState.saved_CurrentScore > gameState.saved_HighestScore ) {
		
			gameState.saved_HighestScore = gameState.saved_CurrentScore;
		
		}
	
	}	

#endif // defined(GAME_HAS_SCORE_AND_HISCORE)
	
	// ========================================================================
	
	//
	//	FOODCHAIN_SetupSpecialEntityPair()
	//
	
#if defined(FOOD_CHAIN_LEVEL_GOALS)

	INTERNAL_METHOD( void )
	FOODCHAIN_SetupSpecialEntityPair(
		short entity_type_a
		,int class_value_a
		,short entity_type_b
		,int class_value_b
	)
	{
	
		try {
		
			game_ENTITY entity;
			
			entity = (game_ENTITY)gameState.foodchain_SpecialEntities.elementAt( 0 );
		
			if ( -1 != entity_type_a ) {
			
				InitializeEntityAt(
					entity
					,entity_type_a
					,entity.map_x
					,entity.map_y
					,(short)0
					,true
					,true
					,class_value_a
				);
				
			} else {
			
				entity.flags |= game_ENTITY_NOT_ACTIVE;
				
			}
			
			// ----------------------------------------------------------------
			
			entity = (game_ENTITY)gameState.foodchain_SpecialEntities.elementAt( 1 );
			
			if ( -1 != entity_type_b ) {
			
				InitializeEntityAt(
					entity
					,entity_type_b
					,entity.map_x
					,entity.map_y
					,(short)0
					,true
					,true
					,class_value_b
				);
				
			} else {
			
				entity.flags |= game_ENTITY_NOT_ACTIVE;
			
			}

		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_SETUP_SPECIAL_ENTITIES );
		
		}
	
	}
	
	//
	//	FindFirstEntityTypeIndexForCoreType()
	//
	
	INTERNAL_METHOD( short )
	FindFirstEntityTypeIndexForCoreType( int type ) {
	
		int typeCount = gameState.entityInfoTable.length;
	
		for ( int i = 0; i < typeCount; i++ ) {
		
			if ( type == gameState.entityInfoTable[ i ].type ) {
			
				return (short)i;
			
			}
		
		}
	
		return (short)-1;
	
	}

#endif // defined(FOOD_CHAIN_LEVEL_GOALS)

	// ========================================================================
	
	//
	//	CheckNormalLevelGoals()
	//
	
	INTERNAL_METHOD( void )
	CheckNormalLevelGoals()
	{
	
#if defined(FOOD_CHAIN_LEVEL_GOALS)

/*
	----------------------------------------------------------------------------

	FoodChain level goals

	----------------------------------------------------------------------------
*/	

		switch ( gameState.currentLevelType ) {
		
		case LEVEL_TYPE_FOODCHAIN_SCORE: {
		
				if ( 0 == gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_SPECIAL_PLAY_BUTTON ] ) {
				
					game_ENTITY entity;
					
					if ( 0 == gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_SPECIAL_TIMER_A ] ) {
					
						if ( gameState.foodchain_CurrentCage != gameState.foodchain_NextCage ) {
						
							gameState.foodchain_CurrentCage = gameState.foodchain_NextCage;
							
							if ( gameState.foodchain_NextCage < gameState.foodchain_CagedAnimalCount ) {
							
								FOODCHAIN_SetupSpecialEntityPair(
									gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_entity_type
									,gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_class_value
									,gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].cage_entity_type
									,gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].cage_class_value
								);
								
								CreateEntityTypeAt(
									FindFirstEntityTypeIndexForCoreType( GAME_ENTITY_INFO_TYPE_SPECIAL_TIMER_A )
									,0
									,0
									,false
									,0
								);
								
								break; // pause initially
			
							}
						
						}					
					
						if ( gameState.foodchain_CurrentCage < gameState.foodchain_CagedAnimalCount ) {
						
							if ( 0 != gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_class_value ) {
							
								AddToScore(
									gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].cage_class_value
								);
								
								--gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_class_value;
								
								// create next count down timer....
								
								try {
								
									entity = (game_ENTITY)gameState.foodchain_SpecialEntities.elementAt( 0 );
									
									entity.class_value = gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_class_value;
									
								} catch ( Throwable e ) {
								
									REPORT_EXCEPTION_POLICY( e, EXCEPTION_SYNC_ANIMAL_CLASS_VALUE );
			
								}
								
//System.out.println( "starting timer" );								
							
							}
							
							if ( 0 == gameState.foodchain_CagedAnimalsInformation[ gameState.foodchain_CurrentCage ].animal_class_value ) {
							
								++gameState.foodchain_NextCage;
							
							} else {
							
								CreateEntityTypeAt(
									FindFirstEntityTypeIndexForCoreType( GAME_ENTITY_INFO_TYPE_SPECIAL_TIMER_A )
									,0
									,0
									,false
									,0
								);
									
							}
							
						} else {
						
							short entity_type = FindFirstEntityTypeIndexForCoreType(
								GAME_ENTITY_INFO_TYPE_SPECIAL_PLAY_BUTTON
							);
							
							if ( -1 != entity_type ) {
						
								FOODCHAIN_SetupSpecialEntityPair(
									entity_type
									,0
									,(short)-1
									,0
								);
								
							} else {
							
								gameState.requestLevelChange = (byte)(gameState.saved_HighestUnlockedLevel);
								
							}
				
						}
					
					}
					
				} else {
				
					if ( 0 != ((GameInternals_INPUT_BUTTON_A|GameInternals_INPUT_ANY_DPAD) & game_pad_flags) ) {
					
						gameState.requestLevelChange = (byte)(gameState.saved_HighestUnlockedLevel);
						
					}
					
				}
				
			}
			break;
			
		default:
		case LEVEL_TYPE_NORMAL: {

				int cagedAnimals = gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_CAGED_ANIMAL ];

				int animalTypeCount = 
					cagedAnimals
				+	gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_PLAYER ]
				+	gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_PLAYER_ANIMATE_ONCE ]
				;

				int filledCageCount = gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_UNTOUCHABLE_GOAL ];

				int cageTypeCount = 
					filledCageCount +
					gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_MOVING_PRIZE ] +
					gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_STATIC_PRIZE ]
					;

		//		if ( (0 != cagedAnimals) && (cageTypeCount == cagedAnimals) && (0 == (cageTypeCount - filledCageCount)) ) {
				if ( (0 == (cageTypeCount - filledCageCount)) ) {

					gameState.status |= GAME_STATE_SF_GOAL_MET;

				} else if ( cageTypeCount != animalTypeCount ) {

					gameState.status |= GAME_STATE_SF_PLAYER_DEAD;

				}
				
			}
			break;
			
		}

#else // defined(FOOD_CHAIN_LEVEL_GOALS)

/*
	----------------------------------------------------------------------------

	Turn-on's and Pick-up's level goals

	----------------------------------------------------------------------------
*/	
		
		int prizeCount = 
			gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_MOVING_PRIZE ] +
			gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_STATIC_PRIZE ] +
			gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_EOL_PRIZE ]
			;

		if ( 0 == prizeCount ) {

			if ( 0 != gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_UNTOUCHABLE_GOAL ] ) {

				if ( 0 == GAME_ChangeEntitiesToEndOfLevelType(
					GAME_ENTITY_INFO_TYPE_UNTOUCHABLE_GOAL ) ) {

					gameState.status |= GAME_STATE_SF_GOAL_MET;

				}

			} else {

				if ( 0 == gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_GOAL ] ) {

					if ( 0 != gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_GOON ] ) {

						if ( 0 == GAME_ChangeEntitiesToEndOfLevelType(
							GAME_ENTITY_INFO_TYPE_GOON ) ){

							gameState.status |= GAME_STATE_SF_GOAL_MET;

						}

					} else {
					
						gameState.status |= GAME_STATE_SF_GOAL_MET;
						
						// check to see if the player collected all the hearts
						
						if ( 0 == gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_UNPICKED_UP_EOL_PRIZE ] ) {
						
							if ( 24 >= gameState.currentLevelNumber ) {
							
								gameState.saved_CollectedHeartBits |= 1 << (gameState.currentLevelNumber - 1);
							
							}
							
						}

					}

				}

			}

		}
		
		// --------------------------------------------------------------------
		
		int playerTypeCount = 
			gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_PLAYER ]
		+	gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_PLAYER_ANIMATE_ONCE ]
		;
	
		if ( 0 == playerTypeCount ) {
		
			gameState.status |= GAME_STATE_SF_PLAYER_DEAD;
		
		}
		
#endif // defined(FOOD_CHAIN_LEVEL_GOALS)
	
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	Frame();
	//
	
	SPECIAL_EXTERNAL_METHOD( SPECIAL_METHOD_PREFIX, void )
	Frame()
	{
		// ====================================================================
		
#if defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

		++dbug_InsideFrameCounter;
		
#endif // defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

		// ====================================================================

#if defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS)

		long dbug_inTime = System.currentTimeMillis();

		System.out.println( "F:A:" );
			
#endif

		// ====================================================================
		
		try {
	
			while ( true ) {
		
				// ------------------------------------------------------------
				
#if defined(DBUG_SIMPLE_PROFILER)

				gameState.simpleProfiler.Reset();
				
#endif

				// ------------------------------------------------------------
				
#ifdef GAME_AUTOMATED_TESTING_HACK

				if ( HACKOLA_bAutomatedTesting && (600 < gameState.frame) ) {
				
					ReturnToLevelSelection();
		//			HACKOLA_GenerateRandomLevel();
					
				}
				
#endif // GAME_AUTOMATED_TESTING_HACK
				
				// ------------------------------------------------------------
				
				while ( true ) {
				
					// --------------------------------------------------------

					if ( 0 == gameState.status ) {

						// Process player first so that the other entities can respond to
						// changes in the map appopriately
						// ----------------------------------------------------
						
						gameState.collectorEntityCount = 0;

						for ( int e = 0; e < gameState.activeEntities; e++ ) {
						
							if ( 0 != (game_ENTITY_NOT_ACTIVE & gameState.entities[ e ].flags) ) continue;

							if ( GAME_ENTITY_INFO_TYPE_PLAYER == 
								gameState.entityInfoTable[ gameState.entities[ e ].entity_type ].type ) {

								gameState.entitiesThatCanCollectThings[ gameState.collectorEntityCount++ ] = (byte)e;

							} else if ( 0 != (ENTITY_MOVEMENT_ITEM_COLLECTOR & gameState.entities[ e ].movement_type) ) {

								gameState.entitiesThatCanCollectThings[ gameState.collectorEntityCount++ ] = (byte)e;

							}

						}
						
						// ----------------------------------------------------

						DecodeInputStreams();
								
#if defined(DBUG_SIMPLE_PROFILER)
						int pid = gameState.simpleProfiler.Start( "PE" );
#endif

						// ----------------------------------------------------

#if defined(GAME_HAS_A_TILE_CURSOR)

						if ( (0 != gameState.cursor_flags) && (0 != game_pad_flags) ) {
						
							if ( 0 == gameState.cursor_last_input_bits ) {
							
								gameState.cursor_repeat_state = 0;
								
							} else if ( ++gameState.cursor_repeat_state >= gameState.cursor_repeat_rate ) {
							
								gameState.cursor_repeat_state = 0;
								
							}
						
							if (
								(0 != (GameInternals_INPUT_BUTTON_A & game_pad_flags))
								&& (0 == (GameInternals_INPUT_BUTTON_A & gameState.cursor_last_input_bits))
								) {
							
								int mapIndex = gameState.cursor_map_x + 
									(gameState.active_w * gameState.cursor_map_y);
							
								game_TILE_INFO tileInfo = 
									gameState.tileInfoTable[ gameState.map[ mapIndex ] ];
									
								if ( 0 != (GAME_TILE_INFO_CURSOR_CAN_TRIGGER_ACTION & tileInfo.flags) ) {
									
									PerformActionOnBoardPiece(
										gameState.cursor_map_x
										,gameState.cursor_map_y
									);
									
								}
							
							} else if ( 0 == gameState.cursor_repeat_state ) {
							
								if ( 0 != (GameInternals_INPUT_ANY_DPAD & game_pad_flags) ) {
								
									if ( 0 != (GameInternals_INPUT_DPAD_L & game_pad_flags) ) {
									
										if ( 0 < gameState.cursor_map_x ) --gameState.cursor_map_x;
									
									}

									if ( 0 != (GameInternals_INPUT_DPAD_R & game_pad_flags) ) {
									
										if ( ++gameState.cursor_map_x >= gameState.active_w ) {
										
											gameState.cursor_map_x = (short)(gameState.active_w - 1);
											
										}
									
									}

									if ( 0 != (GameInternals_INPUT_DPAD_U & game_pad_flags) ) {
									
										if ( 0 < gameState.cursor_map_y ) --gameState.cursor_map_y;
									
									}

									if ( 0 != (GameInternals_INPUT_DPAD_D & game_pad_flags) ) {
									
										if ( ++gameState.cursor_map_y >= gameState.active_h ) {
										
											gameState.cursor_map_y = (short)(gameState.active_h - 1);
											
										}
									
									}
									
								}
							
							}
							
						}

						gameState.cursor_last_input_bits = game_pad_flags;
						
#endif // defined(GAME_HAS_A_TILE_CURSOR)

						// ----------------------------------------------------

						ProcessEntities();

#if defined(DBUG_SIMPLE_PROFILER)
						gameState.simpleProfiler.End( pid );
#endif

						++gameState.frame;
					
					}
					
					// --------------------------------------------------------
					
					if ( -1 == gameState.requestLevelChange ) {
					
						break;
						
					}
					
					HACKOLA_LoadLevelNumber( gameState.requestLevelChange, true );
						
					gameState.requestLevelChange = -1;
					
				}

				// ------------------------------------------------------------
				
				if ( 0 == gameState.status ) {

					CheckNormalLevelGoals();

				}
				
				// ------------------------------------------------------------
				// check status to see if we need to transition to another level
				// ------------------------------------------------------------

				if ( 0 == gameState.status ) break;
				
				if ( !HandleEndOfLevel() ) break;
				
			}
			
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_FRAME_HANDLER );
			
#if defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS) || defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

		} finally {
		
			// ================================================================
			
	#if defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

			--dbug_InsideFrameCounter;
	#endif

			// ================================================================
		
	#if defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS)

			System.out.println( "F:B:" + (System.currentTimeMillis() - dbug_inTime) );
				
	#endif
			
			// ================================================================
			
#endif // defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS) || defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)
		
		}

	}
	
	// ------------------------------------------------------------------------
	
	//
	//	paint()
	//
	
	SPECIAL_EXTERNAL_METHOD( SPECIAL_METHOD_PREFIX, void )
	paint( Graphics g ) {
	
		// ====================================================================
		
#if defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

		if ( 0 != dbug_InsideFrameCounter ) {
		
			System.out.println( "Paint called while still inside Frame()!" );
		
		}
		
#endif // defined(DBUG_DONT_ALLOW_PAINT_IF_INSIDE_FRAME)

		// ====================================================================
		
#if defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS)

		long dbug_inTime = System.currentTimeMillis();

		System.out.println( "P:A:" );
			
#endif

		// ====================================================================
		
#if defined(USE_NOKIA_BACKLIGHT_CONTROL) && defined(SET_BACKLIGHT_EVERY_PAINT)

			if ( policy_Backlight ) {
			
				try {

					DeviceControl.setLights( 0, 100 );
					
				} catch ( Throwable e ) {
				
					REPORT_EXCEPTION_POLICY( e, EXCEPTION_SET_BACKLIGHT_INSIDE_PAINT );
				
				}
				
			}
	
#endif

		// ====================================================================
		
		try {
		
			// sync visual information types with the associated values
			// ----------------------------------------------------------------
			
#if defined(GAME_USES_SCORE_ENTITY_TYPES) && defined(GAME_HAS_SCORE_AND_HISCORE)
			{
			
				game_ENTITY entity;
			
				game_ENTITY_INFO entityInfo;
			
				for ( int e = 0; e < gameState.activeEntities; e++ ) {
				
					entity = gameState.entities[ e ];
				
					if ( 0 != (game_ENTITY_NOT_ACTIVE &	entity.flags) )	continue;
					
					entityInfo = gameState.entityInfoTable[ entity.entity_type ];
					
					switch ( entityInfo.type ) {
					
					case GAME_ENTITY_INFO_TYPE_SPECIAL_SCORE_TRACKER:
						entity.class_value = gameState.saved_CurrentScore;
						break;
						
					case GAME_ENTITY_INFO_TYPE_SPECIAL_HISCORE_TRACKER:
						entity.class_value = gameState.saved_HighestScore;
						break;
						
					case GAME_ENTITY_INFO_TYPE_SPECIAL_LEVEL_TRACKER:
						entity.class_value = gameState.saved_HighestUnlockedLevel;
						break;
					
					}
					
				}
				
			}
#endif // defined(GAME_USES_SCORE_ENTITY_TYPES) && defined(GAME_HAS_SCORE_AND_HISCORE)

			// flush the sounds now 
			// ----------------------------------------------------------------
			
			currentSoundManager.Flush();

			// manage the view (need to keep the player in view)
			// ----------------------------------------------------------------

#if defined(SCROLLING_TILE_MAP_SUPPORT)

			gameState.map_view_pixel_x = 0;
			gameState.map_view_pixel_y = 0;

			gameState.map_view_x_tile_count = gameState.active_w;
			gameState.map_view_y_tile_count = gameState.active_h;

#endif // defined(SCROLLING_TILE_MAP_SUPPORT)

			// Render the playfield (low priority visuals)
			// ----------------------------------------------------------------
			
			if ( gameState.bPlayfieldChanged ) {
			
#if defined(DBUG_SIMPLE_PROFILER)
				int pid = gameState.simpleProfiler.Start( "RP" );
#endif

				GAME_RenderPlayfield();
				
#if defined(DBUG_SIMPLE_PROFILER)
				gameState.simpleProfiler.End( pid );
#endif

				gameState.bPlayfieldChanged = false;
				
			}

			// render the scoreboard
			// ----------------------------------------------------------------
			
			if ( 0 != gameState.ANIM_STATE_POLICY_ACCESS(scoreboardAnimState,animation) ) {
			
				currentAnimEngine.Render(
					gameState.ANIM_STATE_POLICY_ACCESS(scoreboardAnimState,animation)
					,gameState.ANIM_STATE_POLICY_ACCESS(scoreboardAnimState,frame)
					,gameState.ANIM_STATE_POLICY_ACCESS(scoreboardAnimState,conditions_8)
					,0
					,0
					,true
					,null
				);
					
				// currentAnimEngine.AdvanceAnimationState( gameState.scoreboardAnimState );
				
			}
			
			// check to see if we are in heart collection mode...
			// ----------------------------------------------------------------
			
			int countDownTimer = 0;

#if defined(POLICY_SHOW_END_OF_LEVEL_PRIZE_TIMER)

			if ( 0 != gameState.entityTypeHistogram[ GAME_ENTITY_INFO_TYPE_EOL_PRIZE ] ) {
			
				int max_health, entity_type;
			
				for ( int e = 0; e < gameState.activeEntities; e++ ) {
				
					if ( GAME_ENTITY_INFO_TYPE_EOL_PRIZE == 
						gameState.entityInfoTable[ gameState.entities[ e ].entity_type ].type ) {
						
						max_health = gameState.entityInfoTable[ gameState.entities[ e ].entity_type ].max_health;
						
						if ( 0 != max_health ) {
					
							countDownTimer = (gameState.entities[ e ].health << 8) / max_health;
							
							break;
							
						}
					
					}
					
				}
			
			}
			
#endif // defined(POLICY_SHOW_END_OF_LEVEL_PRIZE_TIMER)

			// ----------------------------------------------------------------
			
#if defined(DBUG_SIMPLE_PROFILER)
			int pidBP = gameState.simpleProfiler.Start( "BP" );
#endif

			currentAnimEngine.BeginPaint(
				g
				,gameState.entities[ 0 ].x
				,gameState.entities[ 0 ].y
				,countDownTimer
			);

#if defined(DBUG_SIMPLE_PROFILER)
			gameState.simpleProfiler.End( pidBP );
#endif

			// render the elements
			// ----------------------------------------------------------------

			GAME_RenderEntities();

			// Render the playfield (higher priority visuals)
			// ----------------------------------------------------------------

			// Render
			// ----------------------------------------------------------------
			
#if defined(GAME_HAS_A_TILE_CURSOR)

			if ( (0 != gameState.cursor_flags) 
				&& ((LEVEL_TYPE_NORMAL == gameState.currentLevelType) 
					|| (LEVEL_TYPE_LAST_GAME_LEVEL == gameState.currentLevelType)) ) {
			
				int cursorAnimation = gameState.ANIM_STATE_POLICY_ACCESS(cursor_animstate,animation);
			
				if ( 0 != cursorAnimation ) {
				
					currentAnimEngine.Render(
						cursorAnimation
						,gameState.ANIM_STATE_POLICY_ACCESS(cursor_animstate,frame)
						,gameState.ANIM_STATE_POLICY_ACCESS(cursor_animstate,conditions_8)
						,(gameState.cursor_map_x * GAME_TILE_PIXELS_CX) + (GAME_TILE_PIXELS_CX>>1)
						,(gameState.cursor_map_y * GAME_TILE_PIXELS_CY) + (GAME_TILE_PIXELS_CY>>1)
						,false
						,null
					);
						
#if defined(USE_ANIM_STATE_CLASS)

					currentAnimEngine.AdvanceAnimationState( gameState.cursor_animstate );
					
#else

					// should move the last frame inline!!!!
					
					if ( ++gameState.ANIM_STATE_POLICY_ACCESS(cursor_animstate,frame) > 
						currentAnimEngine.LastFrame( cursorAnimation ) ) {
						
						gameState.ANIM_STATE_POLICY_ACCESS(cursor_animstate,frame) = 0;
						
					}					
#endif
					
				}
			
			}

#endif // defined(GAME_HAS_A_TILE_CURSOR)

			// Render the overlays
			// ----------------------------------------------------------------
			
#ifdef GAME_HAS_OVERLAYS

			GAME_RenderOverlays();
			
#endif

			// finalize display
			// ----------------------------------------------------------------

			currentAnimEngine.EndPaint(
				g
#if defined(BPT_USE_SIMPLE_PROFILER)				
#if defined(DBUG_SIMPLE_PROFILER)
				,gameState.simpleProfiler
#else
				,null
#endif
#endif // defined(BPT_USE_SIMPLE_PROFILER)				
			);

		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_GAME_PAINT );
		
#if defined(DBUG_REPORT_SECTION_ENTER_AND_EXITS)

		} finally {
		
			System.out.println( "P:B:" + (System.currentTimeMillis() - dbug_inTime) );
			
#endif

		}
			
	}
	
	// ------------------------------------------------------------------------
	
	//
	//	FrameMillisecondDelay()
	//
	
	EXTERNAL_METHOD( int )
	FrameMillisecondDelay()
	{
		if ( null == gameState ) return 100;
		
		if ( (!gameState.bValid) || (0 >= gameState.framesPerSecond) ) {
		
			return 100;
		
		}
		
#if defined(GAME_SUPER_FAST_MODE)

		return 33;
#else
		
		return 1000 / gameState.framesPerSecond;
		
#endif

	}
	
	// ------------------------------------------------------------------------
	
	//
	//	MarkEntireBackgroundAsChanged()
	//
	
	INTERNAL_METHOD( void )
	MarkEntireBackgroundAsChanged() {
	
		gameState.bPlayfieldChanged = true;
		
		// --------------------------------------------------------------------
		
#if defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

		gameState.bEntireBackgroundChanged = true;

		for ( int index = (gameState.active_w * gameState.active_h); 0 <= --index; ) {
		
			gameState.map_flags[ index ] = MAP_FLAG_TILE_CHANGED;
		
#if defined(SMARTER_OVERLAPPED_TILE_RENDERING)

			game_TILE_INFO tileInfo = gameState.tileInfoTable[ gameState.map[ index ] ];

			gameState.map_tile_left_reach[ index ] = tileInfo.left_reach;
			
			gameState.map_tile_top_reach[ index ] = tileInfo.top_reach;
			
			gameState.map_tile_right_reach[ index ] = tileInfo.right_reach;
			
			gameState.map_tile_bottom_reach[ index ] = tileInfo.bottom_reach;

#endif // defined(SMARTER_OVERLAPPED_TILE_RENDERING)

		}
			
#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

	}

	//
	//	SetCanvas
	//
	
	EXTERNAL_METHOD( boolean )
	SetCanvas( Canvas canvas ) {
	
		if ( null == currentAnimEngine ) return false;
		
		// --------------------------------------------------------------------
		
		MarkEntireBackgroundAsChanged();
		
		// --------------------------------------------------------------------
			
#if defined(USE_NOKIA_BACKLIGHT_CONTROL)

		if ( policy_Backlight ) {

			DeviceControl.setLights( 0, 100 );
			
		}
	
#endif
				
		// --------------------------------------------------------------------
		
		return currentAnimEngine.SetCanvas( canvas );
	
	}
	
	//
	//	RemoveCanvas()
	//
	
	EXTERNAL_METHOD( void )
	RemoveCanvas( Canvas canvas ) {
	
		if ( null != currentAnimEngine ) {
		
			currentAnimEngine.RemoveCanvas( canvas );
			
			MarkEntireBackgroundAsChanged();
		
		}
	
		// --------------------------------------------------------------------
			
#if defined(USE_NOKIA_BACKLIGHT_CONTROL)

		DeviceControl.setLights( 0, 0 );
	
#endif
				
	}
	
	// =============================================================================
	
    //
    //	RMSHELPER_DecodeInt()
    //
    
    INTERNAL_METHOD( int )
    RMSHELPER_DecodeInt( byte buf[], int offset ) {
    
		int value = (
				((buf[ offset + 0 ] & 0xFF))
			|	((buf[ offset + 1 ] & 0xFF) << 8)
			|	((buf[ offset + 2 ] & 0xFF) << 16)
			|	((buf[ offset + 3 ] & 0xFF) << 24)
		);
		
//System.out.println( value + " == RMSHELPER_DecodeInt() : offset " + offset );		

		return value;
    
    }
    
    //
    //	RMSHELPER_StoreInt()
    //
    
    INTERNAL_METHOD( void )
    RMSHELPER_StoreInt( byte buf[], int offset, int value ) {
    
		buf[ offset + 0 ] = (byte)((value) & 0xFF);
		buf[ offset + 1 ] = (byte)((value >> 8) & 0xFF);
		buf[ offset + 2 ] = (byte)((value >> 16) & 0xFF);
		buf[ offset + 3 ] = (byte)((value >> 24) & 0xFF);
		
//System.out.println( "RMSHELPER_StoreInt( " + value + " ) : offset " + offset );		
    
    }	
	
	// =============================================================================
	
	//
	//	LoadSavedGame()
	//
	
	INTERNAL_METHOD( void )
	LoadSavedGame() {

		// --------------------------------------------------------------------
		
#if defined(GAME_AUTOMATED_TESTING_HACK)

		gameState.saved_HighestUnlockedLevel = 24;
		
		gameState.saved_CollectedHeartBits = 0x00FFFFFF; // 0x00003FFF;
			
#else

		// --------------------------------------------------------------------

		boolean bInitializeToDefaults = true;
		
		RecordStore rmsStore = null;
		
		byte data[];
		
		try {
		
		    rmsStore = RecordStore.openRecordStore( "state", true );
		    
		    // ----------------------------------------------------------------

			if ( 0 != rmsStore.getNumRecords() ) {
			
				data = rmsStore.getRecord( 1 );	
				
				// ------------------------------------------------------------
				
				int dataOffset = -4;
			    
				gameState.saved_HighestUnlockedLevel = (byte)RMSHELPER_DecodeInt( data, dataOffset += 4 );
				
				gameState.saved_CollectedHeartBits = RMSHELPER_DecodeInt( data, dataOffset += 4 );

				policy_Backlight = (0 != RMSHELPER_DecodeInt( data, dataOffset += 4 ));

				policy_Sounds = (0 != RMSHELPER_DecodeInt( data, dataOffset += 4 ));
				
				// ------------------------------------------------------------
				
#if defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				policy_SwapMainCharacter = (0 != RMSHELPER_DecodeInt( data, dataOffset += 4 ));

#endif // defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				// ------------------------------------------------------------
				
#if defined(GAME_HAS_SCORE_AND_HISCORE)

				gameState.saved_CurrentScore = RMSHELPER_DecodeInt( data, dataOffset += 4 );
		
				gameState.saved_HighestScore = RMSHELPER_DecodeInt( data, dataOffset += 4 );

#endif // defined(GAME_HAS_SCORE_AND_HISCORE)

				// ------------------------------------------------------------
				
				bInitializeToDefaults = false;
				
			}	    
		    
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_LOAD_GAME_STATE );
			
		} finally {
		
			data = null;
			
			if ( null != rmsStore ) {
			
				try {
			
					rmsStore.closeRecordStore();
					
				} catch ( Throwable e ) {
				
					REPORT_EXCEPTION_POLICY( e, EXCEPTION_LOAD_GAME_STATE_2 );
					
				}
				
				rmsStore = null;
			
			}
		
		}
			
		// --------------------------------------------------------------------
			
		if ( bInitializeToDefaults ) {
		
			gameState.saved_HighestUnlockedLevel = 1;
			
			gameState.saved_CollectedHeartBits = 0;

			policy_Backlight = true;

			policy_Sounds = true;
			
#if defined(GAME_HAS_SCORE_AND_HISCORE)

			gameState.saved_CurrentScore = 0;
		
			gameState.saved_HighestScore = 5000;

#endif // defined(GAME_HAS_SCORE_AND_HISCORE)

		}
#endif

		// --------------------------------------------------------------------

		gameState.last_SavedCollectedHeartBits = gameState.saved_CollectedHeartBits;
			
	}
	
	//
	//	SaveGameState()
	//
	
	INTERNAL_METHOD( void )
	SaveGameState() {
	
		// --------------------------------------------------------------------
		
		RecordStore rmsStore = null;
		
		byte outputData[];
		
		try {
		
			outputData = new byte [ 16 * 4 ];
		
		    rmsStore = RecordStore.openRecordStore( "state", true );
		    
			// ------------------------------------------------------------
			
			int dataOffset = -4;
			
			RMSHELPER_StoreInt( outputData, dataOffset += 4, gameState.saved_HighestUnlockedLevel );
			
			RMSHELPER_StoreInt( outputData, dataOffset += 4, gameState.saved_CollectedHeartBits );

			RMSHELPER_StoreInt( outputData, dataOffset += 4, policy_Backlight ? 1 : 0 );

			RMSHELPER_StoreInt( outputData, dataOffset += 4, policy_Sounds ? 1 : 0 );
			
			// ----------------------------------------------------------------
				
#if defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

			RMSHELPER_StoreInt( outputData, dataOffset += 4, policy_SwapMainCharacter ? 1 : 0 );

#endif // defined(POLICY_IMPLEMENT_ENTITY_REMAP_ON_LEVEL_LOAD)

				// ------------------------------------------------------------
				
#if defined(GAME_HAS_SCORE_AND_HISCORE)

			RMSHELPER_StoreInt( outputData, dataOffset += 4, gameState.saved_CurrentScore );
		
			RMSHELPER_StoreInt( outputData, dataOffset += 4, gameState.saved_HighestScore );

#endif // defined(GAME_HAS_SCORE_AND_HISCORE)

			// ----------------------------------------------------------------
			
			dataOffset += 4; // finalize the size 
			
//System.out.println( "Data size" + dataOffset ); 
			
			if ( 0 != rmsStore.getNumRecords() ) {
			
				rmsStore.setRecord( 1, outputData, 0, dataOffset ); // outputData.length );
				
			} else {
			
				rmsStore.addRecord( outputData, 0, dataOffset ); // outputData.length );
				
			}
		    
		} catch ( Throwable e ) {
		
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_SAVE_GAME_STATE );
			
		} finally {
		
			if ( null != rmsStore ) {
			
				try {
			
					rmsStore.closeRecordStore();
					
				} catch ( Throwable e ) {
				
					REPORT_EXCEPTION_POLICY( e, EXCEPTION_SAVE_GAME_STATE_2 );
					
				}
				
				rmsStore = null;
			
			}
		
			outputData = null;
			
		}
		
		// --------------------------------------------------------------------
		
		gameState.last_SavedCollectedHeartBits = gameState.saved_CollectedHeartBits;
		
	}
	
	//
	//	ClearSavedGame()
	//
	
	EXTERNAL_METHOD( void )
	ClearSavedGame() {
	
		// --------------------------------------------------------------------
		
#if defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

		gameState.playedCutsceneBits = 0;
		
#endif // defined(PLAY_LEVEL_CUTSCENES_ONCE_PER_SESSION)

		// --------------------------------------------------------------------
		
#if defined(GAME_HAS_SCORE_AND_HISCORE)

		gameState.saved_CurrentScore = 0;
		
#endif // defined(GAME_HAS_SCORE_AND_HISCORE)

		// --------------------------------------------------------------------
		
		gameState.saved_HighestUnlockedLevel = 1;
			
		gameState.saved_CollectedHeartBits = 0;
		
		gameState.levelStack.removeAllElements();
		
		HACKOLA_LoadLevelNumber( (byte)0, true ); // level selection

		SaveGameState();
	
	}
	
	//
	//	IsNewGame()
	//
	
	EXTERNAL_METHOD( boolean )
	IsNewGame() {
	
		return (1 == gameState.saved_HighestUnlockedLevel)
			&& (0 == gameState.saved_CollectedHeartBits);
	
	}
	
	// =============================================================================
	
	//
	//	Bootstrap()
	//
	
	EXTERNAL_METHOD( boolean )
	Bootstrap( String basename, boolean bUseHttp ) {
	
DBUG_DUMP_MEMORY( "Start of Bootstrap" )
	
		try {
		
			// ----------------------------------------------------------------
			
			baseFilesURL = basename;
			bUseHttpForURL = bUseHttp;
		
			// ----------------------------------------------------------------
			
			if ( null == gameState ) {
		
	
DBUG_DUMP_MEMORY( "Before .setup load" )

				gameState = new game_STATE();
				
				gameState.Load( basename + ".setup", bUseHttp );
				
				gameState.saved_HighestUnlockedLevel = 1;
				
				gameState.requestLevelChange = -1;
				
DBUG_DUMP_MEMORY( "After.setup load" )

				gameState.LoadLevelCatalogData( basename + ".game_levels", bUseHttp );
				
DBUG_DUMP_MEMORY( "After.game_levels load" )

			}
			
			// load saved game state
			// ----------------------------------------------------------------
			
			LoadSavedGame();		
	
			// ----------------------------------------------------------------
			
			if ( null == currentAnimEngine ) {
		
DBUG_DUMP_MEMORY( "Before currentAnimEngine load" )

				currentAnimEngine = new AnimationEngine();
			
				currentAnimEngine.Load( basename, bUseHttp );
				
DBUG_DUMP_MEMORY( "After currentAnimEngine load" )

			}
		
			// ----------------------------------------------------------------
			
			if ( null == currentSoundManager ) {
		
DBUG_DUMP_MEMORY( "Before SoundManager load" )

				currentSoundManager = new SoundManager();
			
				currentSoundManager.Load( basename, bUseHttp );
			
DBUG_DUMP_MEMORY( "After SoundManager load" )

			}
		
		} catch ( Throwable e ) {
			
			REPORT_EXCEPTION_POLICY( e, EXCEPTION_BOOTSTRAP_FAILURE );
		
			return false;
			
		}
	
DBUG_DUMP_MEMORY( "End of Bootstrap" )

		return true;
	
	}

	// =============================================================================
	
	SPECIAL_EXTERNAL_METHOD( SPECIAL_METHOD_PREFIX, void )
	Start( boolean bAutoStart ) {
	
#if 1

#if defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

		if ( 1 == gameState.saved_HighestUnlockedLevel ) {
		
			HACKOLA_LoadLevelNumber( gameState.saved_HighestUnlockedLevel, true );

			DecodeInputStreams();
			
			// reset as if DecodeInputStreams() wasn't called yet...
		
			gameState.inputStreamFrameIndex = 0;
			gameState.inputStreamCmdIndex = 0;
			gameState.inputStreamFrame = 0;
			
		} else {
		
			HACKOLA_LoadLevelNumber( (byte)0, true );
			
		}

#else

		if ( bAutoStart ) {
		
			HACKOLA_LoadLevelNumber( gameState.saved_HighestUnlockedLevel, true );

			DecodeInputStreams();
			
			// reset as if DecodeInputStreams() wasn't called yet...
		
			gameState.inputStreamFrameIndex = 0;
			gameState.inputStreamCmdIndex = 0;
			gameState.inputStreamFrame = 0;
		
		} else {

			HACKOLA_LoadLevelNumber( (byte)0, true );

			PlaceEntityOnLevelTile( gameState.entities[ 0 ], gameState.saved_HighestUnlockedLevel );
		
		}

#endif // defined(GAME_DOES_NOT_HAVE_LEVEL_SELECTION_LEVEL)

#else
	
		boolean bNewGame = IsNewGame(); // (1 > gameState.saved_HighestUnlockedLevel);
	
		HACKOLA_LoadLevelNumber( (byte)((bNewGame) ? 1 : 0), true );
		
		if ( !bNewGame ) {
	
			PlaceEntityOnLevelTile( gameState.entities[ 0 ], gameState.saved_HighestUnlockedLevel );
			
		}
		
#endif
		
	}
	
	EXTERNAL_METHOD( void )
	Shutdown() {
	
		SaveGameState();
	
	}
	
} // class GameInternals
