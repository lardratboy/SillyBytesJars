#define INPUT_STREAM_CMD_DOWN					0x03
#define INPUT_STREAM_CMD_LEFT					0x04
#define INPUT_STREAM_CMD_BUTTON_A				0x05
#define INPUT_STREAM_CMD_FULL_INPUT				0x06
#define INPUT_STREAM_CMD_END_LEVEL				0x07
#define INPUT_STREAM_CMD_ENABLE_ENTITY			0x08
#define INPUT_STREAM_CMD_DISABLE_ENTITY			0x09
#define INPUT_STREAM_CMD_RESET_STREAMS			0x0A
#define INPUT_STREAM_CMD_UNPOSSESS_ENTITY		0x0B
#define INPUT_STREAM_CMD_SET_CONDITION_BIT		0x0C
#define INPUT_STREAM_CMD_CLEAR_CONDITION_BITS	0x0D

#define INPUT_STREAM_CMD_MASK					0x0F
#define INPUT_STREAM_INDEX_MASK					0xF0

	// ------------------------------------------------------------------------
	// ------------------------------------------------------------------------
	
