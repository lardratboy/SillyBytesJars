#define ENTITY_MOVEMENT_OVERRIDE_DEFAULT				0x4000

// ----------------------------------------------------------------------------

#define ENTITY_INFO_FLAG_KEEP_CLASS_VALUE_ON_CHANGE		0x0001
#define ENTITY_INFO_FLAG_MUTUAL_HEALTH_TRANSFER			0x0002
