		byte top_reach;						// "" top ""
		byte right_reach;					// "" right ""
		byte bottom_reach;					// "" bottom ""

#endif // defined(USE_DIRTY_BITS_FOR_BACKGROUND_TILES)

#if defined(IMPLEMENT_CLASS_VALUES) // class value added (8/31/03)

		short on_action_create_entity;		// on action create this entity type
		byte class_value_test_type;			// class value test type
		
		short class_value_gateway_bits;		// only runs value tests if one of these bits is present
		short class_value_test_bits;		// class value bit mask to test for
		
		short on_class_true_add;			// addition part of the class value modifier
		short on_class_true_multiplier;		// multiplier part of the class value modifier
		short on_class_true_create_entity;	// create entity on the tile of this type if true
		
		short on_class_false_add;			// addition part of the class value modifier
		short on_class_false_multiplier;	// multiplier part of the class value modifier
		short on_class_false_create_entity;	// create entity on the tile of this type if false
		
#endif // class value added (8/31/03)

		// --------------------------------------------------------------------
		// --------------------------------------------------------------------
		
	} // game_TILE_INFO
 
