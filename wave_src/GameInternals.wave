#define ENTITY_MOVEMENT_INPUT_STREAM_E					0x004E
#define ENTITY_MOVEMENT_INPUT_STREAM_F					0x004F
#define ENTITY_MOVEMENT_INPUT_STREAM_MASK				0x000F
