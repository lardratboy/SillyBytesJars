#define MAP_FLAG_TILE_REDRAW_LEFT					0x0002
#define MAP_FLAG_TILE_REDRAW_TOP					0x0004
#define MAP_FLAG_TILE_REDRAW_RIGHT					0x0008
#define MAP_FLAG_TILE_REDRAW_BOTTOM					0x0010
#define MAP_FLAG_TILE_REDRAW_TOP_LEFT_CORNER		0x0020
#define MAP_FLAG_TILE_REDRAW_TOP_RIGHT_CORNER		0x0040
